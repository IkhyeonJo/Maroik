    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- Loads if the Microsoft.CodeAnalysis its DLL references (4.12 for 5.6.0) is not newer than the SDK's compiler (Roslyn 5.12); the package number is not that version. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Only SA1402 / SA1649 are switched on (.editorconfig). -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <!-- Test-only: FolderRoleArchitectureTests parses the production sources. 5.12.0 is the SDK's own compiler version
         (SDK 11.0.100 ships Roslyn 5.12), so it parses every construct the build accepts. Microsoft.EntityFrameworkCore.Design
         11.0.x asks for the Roslyn workspaces at >= 5.9.0, and each Roslyn package requires its siblings at exactly its own
         version, so the whole family is pinned together here (transitive pinning); moving one alone fails with NU1107 / NU1608.
         Move them with the SDK pin. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>