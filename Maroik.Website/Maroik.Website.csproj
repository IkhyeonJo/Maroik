<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <CopyRefAssembliesToPublishDirectory>false</CopyRefAssembliesToPublishDirectory>
    <UserSecretsId>957902df-6958-4b22-86f9-1a890874d3a3</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
    <AssemblyName>Maroik.Website</AssemblyName>
    <RootNamespace>Maroik.Website</RootNamespace>
  </PropertyGroup>

  <!--
    The Node / TypeScript toolchain for the custom client scripts (TypeScripts/, see
    TypeScripts/README.md) lives inside this project folder. Keep it out of the .NET
    project so `node_modules` (~75 packages) doesn't drown Solution Explorer and — more
    importantly — isn't swept into `dotnet publish` by the Web SDK's `**\*.json` Content
    rule. The compiled wwwroot/**/site.js still publishes as normal `wwwroot` content.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
    <!-- `tsc` runs via the CompileClientTypeScript target below; stop VS's bundled
         TypeScript MSBuild build from also compiling TypeScripts/**. -->
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <!-- toolchain files: still visible in the tree (as None), but not web content / not published -->
    <Content Remove="package.json;package-lock.json;tsconfig.json;tsconfig.build.json;vitest.config.mts;TypeScripts\**;TypeScripts.Tests\**" />
    <None Include="package.json;package-lock.json;tsconfig.json;tsconfig.build.json" />   <!-- .mts already covered by the SDK None glob -->
    <!-- site.js.map is published as-is when present (container debug build), and is simply
         absent from a release build (tsconfig.build.json emits none). Do NOT <Content Remove>
         it here: the debug and prod Docker builds share one `dotnet publish -c Release`. -->

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <!--
    Razor runtime compilation is a dev-box convenience (edit a .cshtml, refresh): launchSettings.json switches it on through
    ASPNETCORE_HOSTINGSTARTUPASSEMBLIES, and no code calls AddRazorRuntimeCompilation. A Release build (every Docker image)
    leaves it out, so the published app does not carry the Roslyn compiler.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maroik.Core.Client\Maroik.Core.Client.csproj" />
    <ProjectReference Include="..\Maroik.Core.Contract\Maroik.Core.Contract.csproj" />
    <ProjectReference Include="..\Maroik.Core.Repository\Maroik.Core.Repository.csproj" />
    <ProjectReference Include="..\Maroik.Core.Service\Maroik.Core.Service.csproj" />
  </ItemGroup>

  <!--
    Custom client scripts: TypeScripts/**/*.ts  ->(tsc)->  wwwroot/**/*.js  (1:1, no bundler);
    the release `npm run build` then minifies each site.js in place (minify-client-scripts.mjs).
    See TypeScripts/README.md.

    This target compiles them as part of `dotnet build` / `dotnet run`, but ONLY where the
    npm toolchain has been installed (Maroik.Website/node_modules/typescript present), or when
    `-p:BuildClientTypeScript=true` is passed (CI does). The generated wwwroot/**/*.js is
    git-ignored; the Docker `build` stage has no Node and gets it from the Dockerfile's
    dedicated `tsbuild` Node stage instead.
    npm's exit code propagates, so a TypeScript error fails the .NET build on dev machines.

    No Node on the machine: a Debug build without node_modules (Rider / Visual Studio container
    "Fast Mode", a plain `dotnet build`) runs the same steps in a throwaway container of the
    Dockerfile's tsbuild image (ClientScriptsInDocker, client-scripts-in-docker.sh), so local
    development needs only Docker. The packages stay in the `maroik-website-node-modules`
    volume, so only the first build (or one after a package-lock.json change) installs them.
    Not inside a container (the SDK image sets DOTNET_RUNNING_IN_CONTAINER) and not for Release
    (the images build there and take their scripts from tsbuild). Switch it off with
    `-p:ClientScriptsInDocker=false`; an `npm ci` here switches back to the machine's own npm.

    Debug builds run `npm run build:debug` (tsconfig.json: sourceMap + inlineSources) instead
    of the map-free `npm run build`, so plain `dotnet build`/`dotnet run` AND Rider/VS
    container "Fast Mode" debugging get a Chrome-debuggable site.js.map with no extra step -
    Fast Mode builds on the host and bind-mounts wwwroot into the container, so the
    Dockerfile's TS_SOURCEMAPS build arg never runs for it. Release builds keep the map-free
    `npm run build`. See "Debugging in Chrome" in TypeScripts/README.md.
  -->
  <PropertyGroup>
    <_ClientTypeScriptNpmScript Condition="'$(Configuration)' == 'Debug'">build:debug</_ClientTypeScriptNpmScript>
    <_ClientTypeScriptNpmScript Condition="'$(_ClientTypeScriptNpmScript)' == ''">build</_ClientTypeScriptNpmScript>
    <ClientScriptsInDocker Condition="'$(ClientScriptsInDocker)' == '' And '$(Configuration)' == 'Debug' And '$(DOTNET_RUNNING_IN_CONTAINER)' != 'true' And !Exists('$(MSBuildProjectDirectory)/node_modules/typescript')">true</ClientScriptsInDocker>
    <!-- The Dockerfile's tsbuild image (pinned equal by ClientScriptToolchainArchitectureTests). -->
    <ClientScriptNodeImage>node:22-alpine</ClientScriptNodeImage>
    <_ClientScriptDockerRun>docker run --rm -v "$(MSBuildProjectDirectory):/w/app" -v maroik-website-node-modules:/w -w /w/app $(ClientScriptNodeImage) sh client-scripts-in-docker.sh</_ClientScriptDockerRun>
  </PropertyGroup>
  <Target Name="CompileClientTypeScript"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildProjectDirectory)/node_modules/typescript') Or '$(BuildClientTypeScript)' == 'true' Or '$(ClientScriptsInDocker)' == 'true'">
    <Message Importance="high" Text="tsc: compiling TypeScripts/**/*.ts -> wwwroot/**/*.js (npm run $(_ClientTypeScriptNpmScript))" />
    <Exec Condition="'$(ClientScriptsInDocker)' != 'true'" Command="npm run $(_ClientTypeScriptNpmScript)" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Condition="'$(ClientScriptsInDocker)' == 'true'" Command="$(_ClientScriptDockerRun) $(_ClientTypeScriptNpmScript)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!--
    Run the jsdom test suite for the client scripts (Maroik.Website/TypeScripts.Tests)
    after the build. ON by default for local / Rider / VS builds (i.e. any `dotnet build`
    where `npm ci` has been run). Incremental: it re-runs only when a *.ts source, a test,
    or a toolchain config actually changed since the last run, so a C#-only edit + build
    skips it. Force off for a one-off fast build with `-p:RunClientScriptTests=false`.

    Skipped automatically where `node_modules/vitest` is absent (the .NET SDK Docker
    stage, CI that doesn't `npm ci` here), unless ClientScriptsInDocker runs them in the
    Node container (above); the Dockerfile `tsbuild` stage covers the image builds.
  -->
  <PropertyGroup Condition="'$(RunClientScriptTests)' == ''">
    <RunClientScriptTests>true</RunClientScriptTests>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunClientScriptTests)' == 'true'">
    <_ClientScriptTestInput Include="TypeScripts/**/*.ts;TypeScripts.Tests/**/*.ts" />
    <_ClientScriptTestInput Include="tsconfig.json;vitest.config.mts;package.json;minify-client-scripts.mjs" />
  </ItemGroup>

  <Target Name="RunClientScriptTests"
          AfterTargets="Build"
          Condition="'$(RunClientScriptTests)' == 'true' And (Exists('$(MSBuildProjectDirectory)/node_modules/vitest') Or '$(ClientScriptsInDocker)' == 'true')"
          Inputs="@(_ClientScriptTestInput)"
          Outputs="$(IntermediateOutputPath)clientscripttests.stamp">
    <Message Importance="high" Text="vitest: running TypeScripts.Tests" />
    <Exec Condition="'$(ClientScriptsInDocker)' != 'true'" Command="npx vitest run" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Condition="'$(ClientScriptsInDocker)' == 'true'" Command="$(_ClientScriptDockerRun) test" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)clientscripttests.stamp" AlwaysCreate="true" />
  </Target>

</Project>
