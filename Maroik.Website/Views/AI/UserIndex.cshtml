@*
    AI/UserIndex.cshtml
    The AI chat (the "AI Chat" menu entry, User role only). A user asks about their own account book; a local model answers, reading
    the records only through the server's read-only tools. The chat lives in the page (#aiChatMessages); the script sends the earlier
    turns back with each question and shows the streamed answer as it arrives. Nothing is stored on the server.
    An account an administrator has not allowed only sees the note to ask for it, without the form or the script.
    The question's length limit is rendered from AssistantPolicy; the server re-validates it.
*@
@model Maroik.Website.Models.ViewModels.AIChats.AIChatPageViewModel

<section class="content pb-3">
    <div class="container-fluid">
        @if (!Model.Allowed)
        {
            <div class="callout callout-info" id="aiChatNotAllowed">
                <p>@Localizer["The AI chat is not turned on for your account. Please ask the administrator."].Value</p>
            </div>
        }
        else
        {
            @Html.Hidden("localizerAIThinking", Localizer["Thinking"].Value)
            @Html.Hidden("localizerAINoAnswer", Localizer["No answer came. Please try again."].Value)
            <div class="card card-primary card-outline direct-chat direct-chat-primary ai-chat">
                <div class="card-header">
                    <h3 class="card-title">@Localizer["Ask about your account book"].Value</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" id="btnAINewChat">@Localizer["New chat"].Value</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="direct-chat-messages ai-chat-messages" id="aiChatMessages" aria-live="polite"></div>
                </div>
                <div class="card-footer">
                    <form id="formAIChat" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <textarea class="form-control" id="aiQuestion" name="aiQuestion" rows="2" maxlength="@Model.MaxQuestionLength"
                                      placeholder="@Localizer["For example: How much did I spend on food this month?"].Value"></textarea>
                            <span class="input-group-append">
                                <button type="submit" class="btn btn-primary" id="btnAIAsk">@Localizer["Send"].Value</button>
                            </span>
                        </div>
                        <small class="form-text text-muted">
                            @Localizer["The AI only reads your records; it cannot add, change or delete anything. Its answers can be wrong, so check important numbers in your account book."].Value
                        </small>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    @if (Model.Allowed)
    {
        <link rel="stylesheet" href="~/user/custom/AI/UserIndex/css/site.css" asp-append-version="true">
    }
}
@* Page-specific JavaScript: site.js (only with the chat) *@
@section Scripts {
    @if (Model.Allowed)
    {
        <script src="~/user/custom/AI/UserIndex/js/site.js" asp-append-version="true"></script>
    }
}
