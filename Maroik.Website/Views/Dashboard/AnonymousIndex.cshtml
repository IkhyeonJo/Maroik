@*
    Dashboard/AnonymousIndex.cshtml
    Public landing page shown to unauthenticated (Anonymous) visitors.
    Displays a welcome card with a brief description of the site's purpose and
    an invitation to register or explore the forum without logging in.
    All text is localized via IViewLocalizer.
*@
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">
                @Localizer["Maroik – Your Personal Life Management Platform"].Value
            </h3>
        </div>
        <div class="card-body">
            <p>
                @Localizer["Maroik is an integrated web platform designed to help you organize and manage your everyday activities and information."].Value
            </p>

            <ul>
                <li>
                    <strong>@Localizer["Finance Management"].Value</strong>
                    – @Localizer["Track income and expenses and manage your personal finances."].Value
                </li>
                <li>
                    <strong>@Localizer["Calendar Management"].Value</strong>
                    – @Localizer["Organize and manage your personal schedule through an integrated calendar."].Value
                </li>
                <li>
                    <strong>@Localizer["File Management"].Value</strong>
                    – @Localizer["Store and manage your personal files."].Value
                </li>
                <li>
                    <strong>@Localizer["Task Management"].Value</strong>
                    – @Localizer["Organize tasks and track progress using Kanban boards."].Value
                </li>
                <li>
                    <strong>@Localizer["Community"].Value&nbsp;</strong>
                    – @Localizer["Create posts and share information with other users."].Value
                </li>
            </ul>

            <hr />

            <h5>@Localizer["Contact"].Value</h5>
            <p>
                @Localizer["For inquiries or suggestions, please contact us at:"].Value
                <a href="mailto:admin@maroik.com">@Localizer["admin@maroik.com"].Value</a>
            </p>
        </div>
    </div>
</section>