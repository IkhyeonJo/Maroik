@{
    bool invalidToken = ViewBag.InvalidToken ?? false;
    bool accountCreated = ViewBag.AccountCreated ?? false;
    var error = TempData["Error"] as string;
}

@if (invalidToken == false && accountCreated == false) // 1.	이미 이메일 인증 하셨습니다. [로그인 화면으로] <- 버튼
{
    <div class="register-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>My</b>Laboratory</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">You have already verified your email</p>
                <button type="button" class="btn btn-success btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i>Back To Login Page</button>
            </div>
            <!-- /.form-box -->
        </div><!-- /.card -->
    </div>
}
else if (invalidToken == false && accountCreated == true) // 1.	계정이 성공적으로 생성되었습니다. [로그인 화면으로] <- 버튼
{
    <div class="register-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>My</b>Laboratory</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Your account has been successfully created</p>
                <button type="button" class="btn btn-success btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i>Back To Login Page</button>
            </div>
            <!-- /.form-box -->
        </div><!-- /.card -->
    </div>
}
else if (invalidToken == true && accountCreated == false) // 1.	승인 코드가 유효하지 않습니다. [로그인 화면으로] <- 버튼
{
    <div class="register-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>My</b>Laboratory</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">The authentication token is invalid.</p>
                <button type="button" class="btn btn-success btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i>Back To Login Page</button>
            </div>
            <!-- /.form-box -->
        </div><!-- /.card -->
    </div>
}
else if (invalidToken == true && accountCreated == true) // 1.	(있을 수 없는 일) [이메일 활성화 중 예외 발생 시 사용하는 페이지]
{
    <div class="register-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>My</b>Laboratory</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Exception!!</p>
                <p class="mb-0">
                    <font style="font-weight:bold" color="red">@error</font>
                </p>
            </div>
            <!-- /.form-box -->
        </div><!-- /.card -->
    </div>
}