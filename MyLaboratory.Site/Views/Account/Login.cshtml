@using MyLaboratory.Site.Models.ViewModels.Account

@model LoginInputViewModel

@{
    var error = TempData["Error"] as string;
}

<div class="login-box">

    <!-- /.login-logo -->
    <div class="login-box-body">
        <div class="login-logo">
            <a href="/"><b>My</b>Laboratory</a>
        </div>
        <p class="login-box-msg">Sign in to start your session</p>
        <form name="loginForm" class="form-horizontal" method="post" asp-controller="Account" asp-action="Login">
            @Html.AntiForgeryToken()
            <div class="form-group has-feedback">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Email" />
                <span class="glyphicon glyphicon-envelope form-control-feedback"></span>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group has-feedback">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-xs-4">
                    <button type="submit" class="btn btn-primary btn-block btn-flat">Sign In</button>
                </div>
                <h2 style="padding:20px; margin-top:50px;font-size: 20px;color: red;">@error</h2>
            </div>
        </form>
    </div>
    <!-- /.login-box-body -->
</div>