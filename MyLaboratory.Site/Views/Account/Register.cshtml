@using MyLaboratory.Site.Models.ViewModels.Account

@model LoginOutputViewModel

<div class="register-box">
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="#" class="h1"><b>My</b>Laboratory</a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">Register a new membership</p>

            <form name="registerForm" class="form-horizontal" method="post" asp-controller="Account" asp-action="Register">
                @Html.AntiForgeryToken()
                <div class="form-group has-feedback">
                    <input asp-for="FullName" type="text" class="form-control" placeholder="Full Name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="form-group has-feedback">
                    <input asp-for="Email" type="email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group has-feedback">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group has-feedback">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input asp-for="AgreedServiceTerms" />
                            <label for="AgreedServiceTerms">
                                I agree to the <a asp-controller="Account" asp-action="ConsentForm" target="_blank" rel="noopener noreferrer">terms</a> @* rel="noopener noreferrer" // prevent tabnabbing (https://www.freecodecamp.org/news/how-to-use-html-to-open-link-in-new-tab/) *@
                            </label>
                        </div>
                    </div>
                    <!-- /.col -->
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Register</button>
                    </div>
                    <!-- /.col -->
                </div>
            </form>

            <a asp-controller="Account" asp-action="Login" class="text-center">I already have a membership</a>
        </div>
        <!-- /.form-box -->
    </div><!-- /.card -->
</div>