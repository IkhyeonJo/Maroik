@using MyLaboratory.Site.Models.ViewModels.Account

@model LoginOutputViewModel

@{
    var error = TempData["Error"] as string;
}
<div class="login-box">
    <div class="card card-outline card-primary">
        <div class="card-header text-center">
            <a href="#" class="h1"><b>My</b>Laboratory</a>
        </div>
        <div class="card-body">
            <p class="login-box-msg">You forgot your password? Here you can easily retrieve a new password.</p>
            <form id="forgotPasswordForm" class="form-horizontal" method="post" asp-controller="Account" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()
                <div class="form-group has-feedback">
                    <input asp-for="Email" type="email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-block" onclick="ShowForgotPasswordLoading()">Request new password</button>
                    </div>
                </div>
            </form>
            <p class="mt-3 mb-1">
                <a asp-controller="Account" asp-action="Login">Login</a>
                <br />
                <div style="text-align:center">
                    <font style="font-weight:bold" color="red">@error</font>
                </div>
            </p>
        </div>
    </div>
</div>
<div class="modal" id="loading">
    <img src="~/adminlte/custom/Account/img/ajax-loader.gif" />
</div>
@section Scripts{
    <script src="~/adminlte/custom/Account/js/site.js" asp-append-version="true"></script>
}