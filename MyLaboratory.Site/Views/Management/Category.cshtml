<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Category Management</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display:flex; align-items:center">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <input type="text" id="GridSearch" placeholder="Search..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                    </li>
                </ul>

                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <form id="myForm" method="post" asp-controller="Management" asp-action="CategoryExportExcel">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fileName" value="Category-SubCategory" />
                            <a role="button" style="color: rgba(255,255,255,.75);" onclick="document.getElementById('myForm').submit();">
                                <i class="fas fa-file-excel"></i>
                            </a>
                        </form>
                    </li>
                </ul>
            </nav>
            @Html.AjaxGrid(Url.Action("Category", "Management"))
        </div>
    </div>
</section>
