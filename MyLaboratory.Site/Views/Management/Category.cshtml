@model MyLaboratory.Site.Models.ViewModels.Management.ManagementOutputViewModel

@Html.AntiForgeryToken()
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Category Management</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                <ul class="navbar-nav">
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-primary btn-block btn-sm" data-toggle="modal" data-target="#CreateDialogModal" data-backdrop="static" data-keyboard="false" style="width: 100px !important;"><i class="fa fa-plus" style="padding-right:3px;"></i> CREATE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-success btn-block btn-sm" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> EDIT</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-danger btn-block btn-sm" style="width: 100px !important;"><i class="fa fa-trash" style="padding-right:3px;"></i> DELETE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-secondary btn-block btn-sm" onclick="CategoryExportExcel()" style="width: 100px !important;"><i class="fas fa-file-excel" style="padding-right:3px;"></i> EXCEL</button>
                    </li>
                    <li class="nav-item ml-auto">
                        <input type="text" id="GridSearch" placeholder="Search..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                    </li>
                </ul>
            </nav>
            @Html.AjaxGrid(Url.Action("Category", "Management"))
        </div>
    </div>
</section>

@*<!--CreateDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="CreateDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="Tabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#Tabs-1">Add Category</a></li>
                    <li><a href="#Tabs-2">Add SubCategory</a></li>
                </ul>
                @*Tabs-1: Create Category Modal*@
                <div id="Tabs-1">
                    <form id="CategoryCreate" method="post">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Name"></label>
                                <input asp-for="Name" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="DisplayName"></label>
                                <input asp-for="DisplayName" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="IconPath"></label>
                                <input asp-for="IconPath" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Controller"></label>
                                <input asp-for="Controller" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Action"></label>
                                <input asp-for="Action" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Role"></label>
                                <br />
                                <select asp-for="Role">
                                    <option value="Admin">관리자</option>
                                    <option value="User">사용자</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Order"></label>
                                <input asp-for="Order" class="form-control form-control-sm" min="0" />
                            </div>
                        </div>
                    </form>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="CreateCategory()">Create</button>
                    </div>
                </div>
                @*Tabs-2: Create SubCategory Modal*@
                <div id="Tabs-2">
                    <form id="SubCategoryCreate" method="post">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="CategoryId"></label>
                                <input asp-for="CategoryId" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Name"></label>
                                <input asp-for="Name" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="DisplayName"></label>
                                <input asp-for="DisplayName" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="IconPath"></label>
                                <input asp-for="IconPath" class="form-control form-control-sm" />
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Action"></label>
                                <input asp-for="Action" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Role"></label>
                                <br />
                                <select asp-for="Role">
                                    <option value="Admin">관리자</option>
                                    <option value="User">사용자</option>
                                </select>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label asp-for="Order"></label>
                                <input asp-for="Order" class="form-control form-control-sm" min="0" />
                            </div>
                        </div>
                    </form>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="CreateSubCategory()">Create</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/custom/Management/Category/js/site.js" asp-append-version="true"></script>
