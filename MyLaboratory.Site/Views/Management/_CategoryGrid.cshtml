@model IQueryable<MyLaboratory.Site.Models.ViewModels.Management.ManagementOutputViewModel>

@* Should only include grid declaration *@

@(Html
    .Grid(Model)
    .Build(columns =>
    {
        columns.Add(model => model.Id).Titled("Id");
        columns.Add(model => model.CategoryId).Titled("CategoryId");
        columns.Add(model => model.Name).Titled("Name");
        columns.Add(model => model.DisplayName).Titled("DisplayName");
        columns.Add(model => model.IconPath).Titled("IconPath");
        columns.Add(model => model.Controller).Titled("Controller");
        columns.Add(model => model.Action).Titled("Action");
        columns.Add(model => model.Role).Titled("Role");
        columns.Add(model => model.Order).Titled("Order");

    })
    .Id("my-grid")
    .Css("table table-striped")
    .AppendCss("table-hover")
    //.Attributed(new { data_type = "individuals" })
    //.RowAttributed(model => new { @class = model.IsWorking == true ? "working" : null, data_id = model.Id })
    .RowAttributed(model => new { @class = "table-inactive", data_id = model.Id, data_categoryid = model.CategoryId ?? -1 })
    .Using(GridFilterMode.Row)
    .Empty("No data found")
    .Filterable()
    .Sortable()
    .Pageable(pager => {
        pager.PageSizes = new Dictionary<Int32, string> { { 10, "10" }, { 25, "25" }, { 50, "50" }, {100, "100" } };
        pager.ShowPageSizes = true;
        pager.RowsPerPage = 10;
    })
)