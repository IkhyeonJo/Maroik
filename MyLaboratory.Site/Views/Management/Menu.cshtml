@Html.AntiForgeryToken()
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Category Management</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                <ul class="navbar-nav">
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-primary btn-block btn-sm" data-toggle="modal" data-target="#createMenuDialogModal" data-backdrop="static" data-keyboard="false" style="width: 100px !important;"><i class="fa fa-plus" style="padding-right:3px;"></i> CREATE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-success btn-block btn-sm" onclick="EditMenuGridRow('Please select grid row')" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> EDIT</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-danger btn-block btn-sm" onclick="ConfirmDeleteMenu('Please select grid row')" style="width: 100px !important;"><i class="fa fa-trash" style="padding-right:3px;"></i> DELETE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-secondary btn-block btn-sm" onclick="ExportExcelMenu()" style="width: 100px !important;"><i class="fas fa-file-excel" style="padding-right:3px;"></i> EXCEL</button>
                    </li>
                    <li class="nav-item ml-auto">
                        <input type="text" id="gridSearch" placeholder="Search..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                    </li>
                </ul>
            </nav>
            @Html.AjaxGrid(Url.Action("Menu", "Management"))
        </div>
    </div>
</section>

@*<!--createMenuDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="createMenuDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="createMenuTabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#createMenuTabs-1">Add Category</a></li>
                    <li><a href="#createMenuTabs-2">Add SubCategory</a></li>
                </ul>
                @*Tabs-1: Create Category Modal*@
                <div id="createMenuTabs-1">
                    <form id="formCreateCategory" onsubmit="return CreateCategory()">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryName">Name</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Name" id="createCategoryName" name="createCategoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryDisplayName">DisplayName</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter DisplayName" id="createCategoryDisplayName" name="createCategoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryIconPath">IconPath</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter IconPath" id="createCategoryIconPath" name="createCategoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryController">Controller</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Controller" id="createCategoryController" name="createCategoryController" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryController" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryAction">Action</label>
                                <input class="form-control form-control-sm" type="text" data-val="false" id="createCategoryAction" name="createCategoryAction" value="">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryRole">Role</label>
                                <br />
                                <select id="createCategoryRole" name="createCategoryRole">
                                    <option value="Admin">Admin</option>
                                    <option value="User">User</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryOrder">Order</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createCategoryOrder" name="createCategoryOrder" value="0">
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <input type="submit" class="btn btn-primary" value="Save" />
                        </div>
                    </form>
                </div>
                @*Tabs-2: Create SubCategory Modal*@
                <div id="createMenuTabs-2">
                    <form id="formCreateSubCategory" onsubmit="return CreateSubCategory()">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryCategoryId">CategoryId</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createSubcategoryCategoryId" name="createSubcategoryCategoryId" value="0">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryName">Name</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Name" id="createSubcategoryName" name="createSubcategoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryDisplayName">DisplayName</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter DisplayName" id="createSubcategoryDisplayName" name="createSubcategoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryIconPath">IconPath</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter IconPath" id="createSubcategoryIconPath" name="createSubcategoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryAction">Action</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Action" id="createSubcategoryAction" name="createSubcategoryAction" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryAction" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryRole">Role</label>
                                <br />
                                <select id="createSubcategoryRole" name="createSubcategoryRole">
                                    <option value="Admin">Admin</option>
                                    <option value="User">User</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryOrder">Order</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createSubcategoryOrder" name="createSubcategoryOrder" value="0">
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <input type="submit" class="btn btn-primary" value="Save" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

