@model MyLaboratory.Site.Models.ViewModels.Management.MenuOutputViewModel

@Html.AntiForgeryToken()
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Category Management</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                <ul class="navbar-nav">
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-primary btn-block btn-sm" data-toggle="modal" data-target="#createDialogModal" data-backdrop="static" data-keyboard="false" style="width: 100px !important;"><i class="fa fa-plus" style="padding-right:3px;"></i> CREATE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-success btn-block btn-sm" onclick="EditMenuGridRow()" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> EDIT</button>
                        @*<button type="button" class="btn btn-success btn-block btn-sm" data-toggle="modal" data-target="#editCategoryDialogModal" data-backdrop="static" data-keyboard="false" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> EDIT</button>*@
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-danger btn-block btn-sm" style="width: 100px !important;"><i class="fa fa-trash" style="padding-right:3px;"></i> DELETE</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-secondary btn-block btn-sm" onclick="ExportExcelMenu()" style="width: 100px !important;"><i class="fas fa-file-excel" style="padding-right:3px;"></i> EXCEL</button>
                    </li>
                    <li class="nav-item ml-auto">
                        <input type="text" id="gridSearch" placeholder="Search..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                    </li>
                </ul>
            </nav>
            @Html.AjaxGrid(Url.Action("Menu", "Management"))
        </div>
    </div>
</section>

@*<!--CreateDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="createDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="createMenuTabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#createMenuTabs-1">Add Category</a></li>
                    <li><a href="#createMenuTabs-2">Add SubCategory</a></li>
                </ul>
                @*Tabs-1: Create Category Modal*@
                <div id="createMenuTabs-1">
                    <form id="formCreateCategory">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryName">Name</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Name" id="categoryName" name="categoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="categoryName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryDisplayName">DisplayName</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter DisplayName" id="categoryDisplayName" name="categoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="categoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryIconPath">IconPath</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter IconPath" id="categoryIconPath" name="categoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="categoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryController">Controller</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Controller" id="categoryController" name="categoryController" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="categoryController" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryAction">Action</label>
                                <input class="form-control form-control-sm" type="text" data-val="false" id="categoryAction" name="categoryAction" value="">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryRole">Role</label>
                                <br />
                                <select id="categoryRole" name="categoryRole">
                                    <option value="Admin">관리자</option>
                                    <option value="User">사용자</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="categoryOrder">Order</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="categoryOrder" name="categoryOrder" value="0">
                            </div>
                        </div>
                    </form>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="CreateCategory()">Save</button>
                    </div>
                </div>
                @*Tabs-2: Create SubCategory Modal*@
                <div id="createMenuTabs-2">
                    <form id="formCreateSubCategory">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryCategoryId">CategoryId</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="subcategoryCategoryId" name="subcategoryCategoryId" value="0">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryName">Name</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Name" id="subcategoryName" name="subcategoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="subcategoryName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryDisplayName">DisplayName</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter DisplayName" id="subcategoryDisplayName" name="subcategoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="subcategoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryIconPath">IconPath</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter IconPath" id="subcategoryIconPath" name="subcategoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="subcategoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryAction">Action</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="Please enter Action" id="subcategoryAction" name="subcategoryAction" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="subcategoryAction" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryRole">Role</label>
                                <br />
                                <select id="subcategoryRole" name="subcategoryRole">
                                    <option value="Admin">관리자</option>
                                    <option value="User">사용자</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="subcategoryOrder">Order</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="subcategoryOrder" name="subcategoryOrder" value="0">
                            </div>
                        </div>
                    </form>
                    <div class="modal-footer justify-content-between">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="CreateSubCategory()">Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*<!--EditCategoryDialogModal-->*@
