@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using System.Text
@using MyLaboratory.Site.Data
@using MyLaboratory.Site.Helpers

@{
    var currentController = ViewContext.RouteData.Values["Controller"].ToString();
    var currentAction = ViewContext.RouteData.Values["Action"].ToString();


    byte[] resultByte = null;
    Context.Session.TryGetValue("AccountSession", out resultByte);
    var loginedAccount = JsonConvert.DeserializeObject<Account>(Encoding.Default.GetString(resultByte)); // Get Session
}

<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a asp-controller="DashBoard" asp-action="Index" class="brand-link">
        <img src="~/dist/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
        <span class="brand-text font-weight-light">AdminLTE 3</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar user panel (optional) -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <img src="~/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
            </div>
            <div class="info">
                <a href="#" class="d-block">Alexander Pierce</a>
            </div>
        </div>

        <!-- SidebarSearch Form -->
        <div class="form-inline">
            <div class="input-group" data-widget="sidebar-search">
                <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search">
                <div class="input-group-append">
                    <button class="btn btn-sidebar">
                        <i class="fas fa-search fa-fw"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <!-- Add icons to the links using the .nav-icon class
                with font-awesome or any other icon font library -->

                @if (loginedAccount.Role == Role.Admin) // 로그인 한 사용자의 권한이 Admin인 경우
                {
                    var tempAdminCategories = from adminCategory in DbCache.AdminCategories
                                              orderby adminCategory.Order ascending
                                              select adminCategory;
                    var tempAdminSubCategories = DbCache.AdminSubCategories;

                    foreach (var tempAdminCategory in tempAdminCategories)
                    {
                        if (!string.IsNullOrEmpty(tempAdminCategory.Action)) // 단일 카테고리
                        {
                            if (tempAdminCategory.Controller == currentController && tempAdminCategory.Action == currentAction) // 선택된 것이라면
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminCategory.Action" class="nav-link active">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @tempAdminCategory.DisplayName
                                        </p>
                                    </a>
                                </li>
                            }
                            else // 선택되지 않았다면
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminCategory.Action" class="nav-link">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @tempAdminCategory.DisplayName
                                        </p>
                                    </a>
                                </li>
                            }
                        }
                        else if (string.IsNullOrEmpty(tempAdminCategory.Action)) // 다중 카테고리
                        {
                            var tempAdminSelectedSubCategories = from tempAdminSubCategory in tempAdminSubCategories
                                                                 where tempAdminCategory.Id == tempAdminSubCategory.CategoryId
                                                                 orderby tempAdminSubCategory.Order ascending
                                                                 select tempAdminSubCategory;

                            bool isExistSelectedSubCategoryInCategory = false;

                            foreach (var tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                            {
                                if (tempAdminCategory.Controller == currentController && tempAdminSelectedSubCategory.Action == currentAction)
                                {
                                    isExistSelectedSubCategoryInCategory = true;
                                    break;
                                }
                            }

                            if (isExistSelectedSubCategoryInCategory == true)
                            {
                                <li class="nav-item menu-open">
                                    <a href="#" class="nav-link active">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @tempAdminCategory.DisplayName
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (var tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                                        {
                                            if (tempAdminSelectedSubCategory.Action == currentAction)
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link active">
                                                        <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                        <p>@tempAdminSelectedSubCategory.DisplayName</p>
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link">
                                                        <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                        <p>@tempAdminSelectedSubCategory.DisplayName</p>
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (isExistSelectedSubCategoryInCategory == false)
                            {
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @tempAdminCategory.DisplayName
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (var tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link">
                                                    <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                    <p>@tempAdminSelectedSubCategory.DisplayName</p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    }

                }
                else if (loginedAccount.Role == Role.User) // 로그인 한 사용자의 권한이 User인 경우
                {

                }
                else // 버그임. 로그인한 사용자는 Admin 또는 User 밖에 없음.
                {

                }
            </ul>
        </nav>
        <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
</aside>