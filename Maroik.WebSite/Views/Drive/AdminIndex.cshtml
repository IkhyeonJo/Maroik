@*
    Drive/AdminIndex.cshtml
    Admin drive / file-manager page.
    Identical in structure to Drive/AnonymousIndex.cshtml but uses admin-scoped static assets
    and the admin drive JS (site.js). Provides full file management capabilities
    (upload, rename, delete, copy/move, download, new folder) for the admin's private drive area.
*@
@section Styles {
    <link rel="stylesheet" href="~/admin/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/admin/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/admin/custom/Drive/AdminIndex/css/site.css" asp-append-version="true">
}

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-folder-open"></i>
                Drive
            </h3>

        </div>
        <div class="card-body">
            <!-- Toolbar -->
            <div class="file-manager-toolbar">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center">
                            <!-- Always visible buttons -->
                            <div class="btn-group btn-group-sm mr-2" role="group">
                                <button type="button" class="btn btn-success" id="btn-upload">
                                    <i class="fas fa-upload"></i> Upload
                                </button>
                                <button type="button" class="btn btn-primary" id="btn-new-folder">
                                    <i class="fas fa-folder-plus"></i> New Folder
                                </button>
                            </div>
                            
                            <!-- Clipboard actions (shown when clipboard has items) -->
                            <div class="btn-group btn-group-sm mr-2 clipboard-actions" role="group" style="display: none;">
                                <button type="button" class="btn btn-outline-success" id="btn-paste">
                                    <i class="fas fa-paste"></i> Paste
                                    <span class="badge badge-light ml-1" id="clipboard-count">0</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-clear-clipboard">
                                    <i class="fas fa-times"></i> Clear
                                </button>
                            </div>
                            
                            <!-- Common action buttons (shown for both files and folders) -->
                            <div class="btn-group btn-group-sm mr-2 common-actions" role="group" style="display: none;">
                                <button type="button" class="btn btn-warning" id="btn-rename">
                                    <i class="fas fa-edit"></i> Rename
                                </button>
                                <button type="button" class="btn btn-danger" id="btn-delete">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            </div>
                            
                            <!-- File-specific buttons -->
                            <div class="btn-group btn-group-sm mr-2 file-actions" role="group" style="display: none;">
                                <button type="button" class="btn btn-info" id="btn-copy">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                                <button type="button" class="btn btn-secondary" id="btn-move">
                                    <i class="fas fa-cut"></i> Cut
                                </button>
                                <button type="button" class="btn btn-primary" id="btn-download">
                                    <i class="fas fa-download"></i> Download
                                </button>
                                <button type="button" class="btn btn-info" id="btn-details">
                                    <i class="fas fa-info-circle"></i> Details
                                </button>
                            </div>
                            
                            <!-- Folder-specific buttons -->
                            <div class="btn-group btn-group-sm mr-2 folder-actions" role="group" style="display: none;">
                                <button type="button" class="btn btn-info" id="btn-open-folder">
                                    <i class="fas fa-folder-open"></i> Open
                                </button>
                                <button type="button" class="btn btn-secondary" id="btn-copy-folder">
                                    <i class="fas fa-copy"></i> Copy
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center justify-content-end">
                            <!-- Search -->
                            <div class="input-group input-group-sm mr-2" style="width: 200px;">
                                <input type="text" class="form-control" placeholder="Search files..." id="search-input">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-default">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Breadcrumb Navigation -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb breadcrumb-nav" id="breadcrumb">
                    <li class="breadcrumb-item active">
                        <i class="fas fa-home"></i>
                        <span class="breadcrumb-path" data-path="/">Home</span>
                    </li>
                </ol>
            </nav>

            <!-- Upload Zone -->
            <div class="upload-zone" id="upload-zone" style="display: none;">
                <i class="fas fa-cloud-upload-alt fa-3x text-muted"></i>
                <p class="text-muted mt-2">Drop files here to upload or click to select files</p>
                <input type="file" id="file-input" multiple style="display: none;">
            </div>

            <!-- Progress Bar Container -->
            <div class="progress-container" id="progress-container" style="display: none;">
                <div class="card">
                    <div class="card-header">
                        <h6 class="card-title mb-0">
                            <i class="fas fa-tasks mr-2"></i>File Operations
                        </h6>
                    </div>
                    <div class="card-body" id="progress-list">
                        <!-- Progress items will be added here dynamically -->
                    </div>
                </div>
            </div>

            <!-- File Content Area -->
            <div id="file-content" class="file-grid">
                <!-- Sample folders and files -->
                <div class="file-item folder-item" data-name="Documents" data-type="folder" data-path="/Documents">
                    <div class="text-center">
                        <i class="fas fa-folder file-icon folder-icon"></i>
                        <div class="file-name">Documents</div>
                    </div>
                </div>
                <div class="file-item folder-item" data-name="Images" data-type="folder" data-path="/Images">
                    <div class="text-center">
                        <i class="fas fa-folder file-icon folder-icon"></i>
                        <div class="file-name">Images</div>
                    </div>
                </div>
                <div class="file-item folder-item" data-name="Downloads" data-type="folder" data-path="/Downloads">
                    <div class="text-center">
                        <i class="fas fa-folder file-icon folder-icon"></i>
                        <div class="file-name">Downloads</div>
                    </div>
                </div>
                <div class="file-item file-type" data-name="document.pdf" data-type="file" data-path="/document.pdf">
                    <div class="text-center">
                        <i class="fas fa-file-pdf file-icon text-danger"></i>
                        <div class="file-name">document.pdf</div>
                    </div>
                </div>
                <div class="file-item file-type" data-name="image.jpg" data-type="file" data-path="/image.jpg">
                    <div class="text-center">
                        <i class="fas fa-file-image file-icon text-success"></i>
                        <div class="file-name">image.jpg</div>
                    </div>
                </div>
                <div class="file-item file-type" data-name="spreadsheet.xlsx" data-type="file" data-path="/spreadsheet.xlsx">
                    <div class="text-center">
                        <i class="fas fa-file-excel file-icon text-success"></i>
                        <div class="file-name">spreadsheet.xlsx</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Context Menu -->
<div class="context-menu" id="context-menu">
    <div class="context-menu-item" data-action="open">
        <i class="fas fa-folder-open mr-2"></i>Open
    </div>
    <div class="context-menu-item" data-action="rename">
        <i class="fas fa-edit mr-2"></i>Rename
    </div>
    <div class="context-menu-item" data-action="copy">
        <i class="fas fa-copy mr-2"></i>Copy
    </div>
    <div class="context-menu-item" data-action="move">
        <i class="fas fa-cut mr-2"></i>Cut
    </div>
    <hr class="my-1">
    <div class="context-menu-item" data-action="download">
        <i class="fas fa-download mr-2"></i>Download
    </div>
    <div class="context-menu-item" data-action="details">
        <i class="fas fa-info-circle mr-2"></i>Details
    </div>
    <div class="context-menu-item" data-action="delete">
        <i class="fas fa-trash mr-2 text-danger"></i>Delete
    </div>
</div>

<!-- Modals -->
<!-- New Folder Modal -->
<div class="modal fade" id="new-folder-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Folder</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="folder-name">Folder Name</label>
                    <input type="text" class="form-control" id="folder-name" placeholder="Enter folder name">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="create-folder-btn">Create</button>
            </div>
        </div>
    </div>
</div>

<!-- Rename Modal -->
<div class="modal fade" id="rename-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename Item</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="new-name">New Name</label>
                    <input type="text" class="form-control" id="new-name" placeholder="Enter new name">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="rename-confirm-btn">Rename</button>
            </div>
        </div>
    </div>
</div>

<!-- File Details Modal -->
<div class="modal fade" id="file-details-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle mr-2"></i>File Details
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <div id="file-preview-icon" class="mb-3">
                            <i class="fas fa-file fa-5x text-secondary"></i>
                        </div>
                        <div id="file-preview-image" class="mb-3" style="display: none;">
                            <img class="img-fluid rounded" style="max-height: 200px;" alt="File preview" src="">
                        </div>
                    </div>
                    <div class="col-md-9">
                        <table class="table table-sm table-striped">
                            <tbody>
                                <tr>
                                    <td class="font-weight-bold" style="width: 30%;">Name:</td>
                                    <td id="detail-name">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Type:</td>
                                    <td id="detail-type">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Size:</td>
                                    <td id="detail-size">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Location:</td>
                                    <td id="detail-location">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Created:</td>
                                    <td id="detail-created">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Modified:</td>
                                    <td id="detail-modified">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Accessed:</td>
                                    <td id="detail-accessed">-</td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold">Permissions:</td>
                                    <td id="detail-permissions">-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row mt-3" id="file-description-section" style="display: none;">
                    <div class="col-12">
                        <h6 class="font-weight-bold">Description:</h6>
                        <p id="file-description" class="text-muted">-</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btn-download-from-details">
                    <i class="fas fa-download mr-1"></i>Download
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/custom/Drive/AdminIndex/js/site.js" asp-append-version="true"></script>
}