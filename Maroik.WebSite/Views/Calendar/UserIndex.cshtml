@using Maroik.WebSite.Utilities
@using Newtonsoft.Json
@using System.Text
@inject Maroik.Common.DataAccess.Contracts.IAssetRepository assetRepository

@{
    string currentCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>().RequestCulture.Culture.Name;
    Context.Session.TryGetValue(Maroik.Common.Miscellaneous.Extensions.EnumHelper.GetDescription(Maroik.Common.Miscellaneous.Utilities.Session.Account), out byte[] resultByte);
    string loginedAccountTimeZoneIanaId = JsonConvert.DeserializeObject<Account>(Encoding.Default.GetString(resultByte)).TimeZoneIanaId;
    List<Asset> assets = (await assetRepository.GetAssetsAsync(JsonConvert.DeserializeObject<Account>(Encoding.Default.GetString(resultByte)).Email)).Where(x => !x.Deleted).ToList();

    DateTime currentTime = DateTime.UtcNow.ConvertTimeByTimeZoneIanaId(loginedAccountTimeZoneIanaId);
    string currentDate = currentTime.ToString("yyyy-MM-dd");
    int currentHour = currentTime.Hour;
    int currentMinute = currentTime.Minute;
    int currentSecond = currentTime.Second;
}

@Html.Hidden("calendarEventModel", JsonConvert.SerializeObject(assets))

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="sticky-top mb-3">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Draggable Events</h4>
                        </div>
                        <div class="card-body">
                            <!-- the events -->
                            <div id="external-events">
                                <div class="external-event bg-success">Lunch</div>
                                <div class="external-event bg-warning">Go home</div>
                                <div class="external-event bg-info">Do homework</div>
                                <div class="external-event bg-primary">Work on UI design</div>
                                <div class="external-event bg-danger">Sleep tight</div>
                                <div class="checkbox">
                                    <label for="drop-remove">
                                        <input type="checkbox" id="drop-remove">
                                        remove after drop
                                    </label>
                                </div>
                            </div>
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Create Event</h3>
                        </div>
                        <div class="card-body">
                            <div class="btn-group" style="width: 100%; margin-bottom: 10px;">
                                <ul class="fc-color-picker" id="color-chooser">
                                    <li><a class="text-primary" href="#"><i class="fas fa-square"></i></a></li>
                                    <li><a class="text-warning" href="#"><i class="fas fa-square"></i></a></li>
                                    <li><a class="text-success" href="#"><i class="fas fa-square"></i></a></li>
                                    <li><a class="text-danger" href="#"><i class="fas fa-square"></i></a></li>
                                    <li><a class="text-muted" href="#"><i class="fas fa-square"></i></a></li>
                                </ul>
                            </div>
                            <!-- /btn-group -->
                            <div class="input-group">
                                <input id="new-event" type="text" class="form-control" placeholder="Event Title">

                                <div class="input-group-append">
                                    <button id="add-new-event" type="button" class="btn btn-primary">Add</button>
                                </div>
                                <!-- /btn-group -->
                            </div>
                            <!-- /input-group -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.col -->
            <div class="col-md-9">
                <div class="card card-primary">
                    <div class="card-body p-0">
                        <!-- THE CALENDAR -->
                        <div id="calendar"></div>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div><!-- /.container-fluid -->
</section>

@*<!--createMenuDialogModal-->*@
<div class="modal fade" tabindex="-1" role="dialog" id="createMenuDialogModal">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="createMenuTabs">
                @*<!--Tab Menu-->*@
                <ul>
                    <li><a href="#createMenuTabs-1">@localizer["Add Category"].Value</a></li>
                    <li><a href="#createMenuTabs-2">@localizer["Add SubCategory"].Value</a></li>
                </ul>
                @*Tabs-1: Create Category Modal*@
                <div id="createMenuTabs-1">
                    <form id="formCreateCategory">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryName">@localizer["Name"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter Name"].Value" id="createCategoryName" name="createCategoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryDisplayName">@localizer["DisplayName"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter DisplayName"].Value" id="createCategoryDisplayName" name="createCategoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryIconPath">@localizer["IconPath"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter IconPath"].Value" id="createCategoryIconPath" name="createCategoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryController">@localizer["Controller"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter Controller"].Value" id="createCategoryController" name="createCategoryController" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createCategoryController" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryAction">@localizer["Action"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="false" id="createCategoryAction" name="createCategoryAction" value="">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryRole">@localizer["Role"].Value</label>
                                <br />
                                <select id="createCategoryRole" name="createCategoryRole" style="max-width:90%;">
                                    <option value="Admin">@localizer["Admin"].Value</option>
                                    <option value="User">@localizer["User"].Value</option>
                                    <option value="Anonymous">@localizer["Anonymous"].Value</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createCategoryOrder">@localizer["Order"].Value</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createCategoryOrder" name="createCategoryOrder" value="0">
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"].Value</button>
                            <input type="submit" class="btn btn-primary" value="@localizer["Save"].Value" />
                        </div>
                    </form>
                </div>
                @*Tabs-2: Create SubCategory Modal*@
                <div id="createMenuTabs-2">
                    <form id="formCreateSubCategory">
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryCategoryId">@localizer["CategoryId"].Value</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createSubcategoryCategoryId" name="createSubcategoryCategoryId" value="0">
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryName">@localizer["Name"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter Name"].Value" id="createSubcategoryName" name="createSubcategoryName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryName" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryDisplayName">@localizer["DisplayName"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter DisplayName"].Value" id="createSubcategoryDisplayName" name="createSubcategoryDisplayName" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryDisplayName" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryIconPath">@localizer["IconPath"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter IconPath"].Value" id="createSubcategoryIconPath" name="createSubcategoryIconPath" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryIconPath" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryAction">@localizer["Action"].Value</label>
                                <input class="form-control form-control-sm" type="text" data-val="true" data-val-required="@localizer["Please enter Action"].Value" id="createSubcategoryAction" name="createSubcategoryAction" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="createSubcategoryAction" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryRole">@localizer["Role"].Value</label>
                                <br />
                                <select id="createSubcategoryRole" name="createSubcategoryRole" style="max-width:90%;">
                                    <option value="Admin">@localizer["Admin"].Value</option>
                                    <option value="User">@localizer["User"].Value</option>
                                    <option value="Anonymous">@localizer["Anonymous"].Value</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-3">
                                <label for="createSubcategoryOrder">@localizer["Order"].Value</label>
                                <input class="form-control form-control-sm" min="0" type="number" id="createSubcategoryOrder" name="createSubcategoryOrder" value="0">
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@localizer["Close"].Value</button>
                            <input type="submit" class="btn btn-primary" value="@localizer["Save"].Value" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

