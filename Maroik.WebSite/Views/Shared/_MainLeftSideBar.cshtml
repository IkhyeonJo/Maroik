@*
    Shared/_MainLeftSideBar.cshtml
    AdminLTE left sidebar partial rendered once per page via _Layout.
    Model: AccountResponse of the logged-in user.
    Renders the brand logo (links to the role-appropriate dashboard) and the dynamic navigation menu.
    Menu items are loaded from ViewBag.{Role}Categories / ViewBag.{Role}SubCategories,
    sorted by Order, and matched against the current controller/action to apply the active highlight.
    Uses a Razor "goto Finish" jump label to break out of nested foreach loops once the active item is found.
*@
@model Maroik.Core.Contract.Dtos.AccountResponse

@{
    string currentControllerName = ViewContext.RouteData.Values["Controller"].ToString();
    string currentActionName = ViewContext.RouteData.Values["Action"].ToString();
}

<aside class="main-sidebar sidebar-dark-primary elevation-4">
    @*<!-- Brand Logo -->*@
    @if (Model.Role == Role.Admin)
    {
        <a asp-controller="DashBoard" asp-action="AdminIndex" class="brand-link">
            <img src="~/admin/dist/img/MaroikLogo.png" alt="Maroik Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
            <span class="brand-text font-weight-light">Maroik</span>
        </a>
    }
    else if (Model.Role == Role.User)
    {
        <a asp-controller="DashBoard" asp-action="UserIndex" class="brand-link">
            <img src="~/user/dist/img/MaroikLogo.png" alt="Maroik Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
            <span class="brand-text font-weight-light">Maroik</span>
        </a>
    }
    else if (Model.Role == Role.Anonymous)
    {
        <a asp-controller="DashBoard" asp-action="AnonymousIndex" class="brand-link">
            <img src="~/anonymous/dist/img/MaroikLogo.png" alt="Maroik Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
            <span class="brand-text font-weight-light">Maroik</span>
        </a>
    }

    @*<!-- Sidebar -->*@
    <div class="sidebar">
        @*<!-- Sidebar user panel (optional) -->*@
        @*
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                @if (Model.Role == Role.Admin)
                {
                    <img src="@Model.AvatarImagePath" class="img-circle elevation-2" alt="User Image">
                }
                else if (Model.Role == Role.User)
                {
                    <img src="@Model.AvatarImagePath" class="img-circle elevation-2" alt="User Image">
                }
                else if (Model.Role == Role.Anonymous)
                {
                    <img src="@Model.AvatarImagePath" class="img-circle elevation-2" alt="User Image">
                }
                else
                {

                }
            </div>
            <div class="info">
                @if (Model.Role == Role.Admin)
                {
                    <a href="#" class="d-block">@Model.Nickname</a>
                }
                else if (Model.Role == Role.User)
                {
                    <a href="#" class="d-block">@Model.Nickname</a>
                }
                else if (Model.Role == Role.Anonymous)
                {
                    <a href="#" class="d-block">@Model.Nickname</a>
                }
                else
                {

                }
            </div>
        </div>
        *@

        @*<!-- SidebarSearch Form -->*@

        @*
        <div class="form-inline">
        <div class="input-group" data-widget="sidebar-search">
        <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search">
        <div class="input-group-append">
        <button class="btn btn-sidebar">
        <i class="fas fa-search fa-fw"></i>
        </button>
        </div>
        </div>
        </div>
        *@

        @*<!-- Sidebar Menu -->*@
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                @*<!-- Add icons to the links using the .nav-icon class
                with font-awesome or any other icon font library -->*@

                @if (Model.Role == Role.Admin) // If the logged-in user has Admin role
                {
                    IOrderedEnumerable<CategoryResponse> tempAdminCategories = from adminCategory in (IEnumerable<CategoryResponse>)ViewBag.AdminCategories
                                                                       orderby adminCategory.Order ascending
                                                                       select adminCategory;
                    IEnumerable<SubCategoryResponse> tempAdminSubCategories = (IEnumerable<SubCategoryResponse>)ViewBag.AdminSubCategories;

                    foreach (CategoryResponse tempAdminCategory in tempAdminCategories)
                    {
                        if (!string.IsNullOrEmpty(tempAdminCategory.Action)) // Single category (no subcategories)
                        {
                            if (tempAdminCategory.Controller == currentControllerName && tempAdminCategory.Action == currentActionName) // If this is the currently selected item
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminCategory.Action" class="nav-link active">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAdminCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                            else // If this item is not selected
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminCategory.Action" class="nav-link">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAdminCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                        }
                        else if (string.IsNullOrEmpty(tempAdminCategory.Action)) // Multi-level category (has subcategories)
                        {
                            IOrderedEnumerable<SubCategoryResponse> tempAdminSelectedSubCategories = from tempAdminSubCategory in tempAdminSubCategories
                                                                                             where tempAdminCategory.Id == tempAdminSubCategory.CategoryId
                                                                                             orderby tempAdminSubCategory.Order ascending
                                                                                             select tempAdminSubCategory;

                            bool isExistSelectedSubCategoryInCategory = false;

                            foreach (SubCategoryResponse tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                            {
                                if (tempAdminCategory.Controller == currentControllerName && tempAdminSelectedSubCategory.Action == currentActionName)
                                {
                                    isExistSelectedSubCategoryInCategory = true;
                                    break;
                                }
                            }

                            if (isExistSelectedSubCategoryInCategory == true)
                            {
                                <li class="nav-item menu-open">
                                    <a href="#" class="nav-link active">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAdminCategory.DisplayName]
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                                        {
                                            if (tempAdminSelectedSubCategory.Action == currentActionName)
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link active">
                                                        <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempAdminSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link">
                                                        <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempAdminSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (isExistSelectedSubCategoryInCategory == false)
                            {
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="@tempAdminCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAdminCategory.DisplayName]
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempAdminSelectedSubCategory in tempAdminSelectedSubCategories)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="@tempAdminCategory.Controller" asp-action="@tempAdminSelectedSubCategory.Action" class="nav-link">
                                                    <i class="@tempAdminSelectedSubCategory.IconPath"></i>
                                                    <p>@localizer[tempAdminSelectedSubCategory.DisplayName]</p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    }

                }
                else if (Model.Role == Role.User) // If the logged-in user has User role
                {
                    IOrderedEnumerable<CategoryResponse> tempUserCategories = from userCategory in (IEnumerable<CategoryResponse>)ViewBag.UserCategories
                                                                      orderby userCategory.Order ascending
                                                                      select userCategory;
                    IEnumerable<SubCategoryResponse> tempUserSubCategories = (IEnumerable<SubCategoryResponse>)ViewBag.UserSubCategories;

                    foreach (CategoryResponse tempUserCategory in tempUserCategories)
                    {
                        if (!string.IsNullOrEmpty(tempUserCategory.Action)) // Single category (no subcategories)
                        {
                            if (tempUserCategory.Controller == currentControllerName && tempUserCategory.Action == currentActionName) // If this is the currently selected item
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempUserCategory.Controller" asp-action="@tempUserCategory.Action" class="nav-link active">
                                        <i class="@tempUserCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempUserCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                            else // If this item is not selected
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempUserCategory.Controller" asp-action="@tempUserCategory.Action" class="nav-link">
                                        <i class="@tempUserCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempUserCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                        }
                        else if (string.IsNullOrEmpty(tempUserCategory.Action)) // Multi-level category (has subcategories)
                        {
                            IOrderedEnumerable<SubCategoryResponse> tempUserSelectedSubCategories = from tempUserSubCategory in tempUserSubCategories
                                                                                            where tempUserCategory.Id == tempUserSubCategory.CategoryId
                                                                                            orderby tempUserSubCategory.Order ascending
                                                                                            select tempUserSubCategory;

                            bool isExistSelectedSubCategoryInCategory = false;

                            foreach (SubCategoryResponse tempUserSelectedSubCategory in tempUserSelectedSubCategories)
                            {
                                if (tempUserCategory.Controller == currentControllerName && tempUserSelectedSubCategory.Action == currentActionName)
                                {
                                    isExistSelectedSubCategoryInCategory = true;
                                    break;
                                }
                            }

                            if (isExistSelectedSubCategoryInCategory == true)
                            {
                                <li class="nav-item menu-open">
                                    <a href="#" class="nav-link active">
                                        <i class="@tempUserCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempUserCategory.DisplayName]
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempUserSelectedSubCategory in tempUserSelectedSubCategories)
                                        {
                                            if (tempUserSelectedSubCategory.Action == currentActionName)
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempUserCategory.Controller" asp-action="@tempUserSelectedSubCategory.Action" class="nav-link active">
                                                        <i class="@tempUserSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempUserSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempUserCategory.Controller" asp-action="@tempUserSelectedSubCategory.Action" class="nav-link">
                                                        <i class="@tempUserSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempUserSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (isExistSelectedSubCategoryInCategory == false)
                            {
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="@tempUserCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempUserCategory.DisplayName]
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempUserSelectedSubCategory in tempUserSelectedSubCategories)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="@tempUserCategory.Controller" asp-action="@tempUserSelectedSubCategory.Action" class="nav-link">
                                                    <i class="@tempUserSelectedSubCategory.IconPath"></i>
                                                    <p>@localizer[tempUserSelectedSubCategory.DisplayName]</p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    }
                }
                else if (Model.Role == Role.Anonymous) // If the user is not logged in (Anonymous)
                {
                    IOrderedEnumerable<CategoryResponse> tempAnonymousCategories = from anonymousCategory in (IEnumerable<CategoryResponse>)ViewBag.AnonymousCategories
                                                                           orderby anonymousCategory.Order ascending
                                                                           select anonymousCategory;
                    IEnumerable<SubCategoryResponse> tempAnonymousSubCategories = (IEnumerable<SubCategoryResponse>)ViewBag.AnonymousSubCategories;

                    foreach (CategoryResponse tempAnonymousCategory in tempAnonymousCategories)
                    {
                        if (!string.IsNullOrEmpty(tempAnonymousCategory.Action)) // Single category (no subcategories)
                        {
                            if (tempAnonymousCategory.Controller == currentControllerName && tempAnonymousCategory.Action == currentActionName) // If this is the currently selected item
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAnonymousCategory.Controller" asp-action="@tempAnonymousCategory.Action" class="nav-link active">
                                        <i class="@tempAnonymousCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAnonymousCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                            else // If this item is not selected
                            {
                                <li class="nav-item">
                                    <a asp-controller="@tempAnonymousCategory.Controller" asp-action="@tempAnonymousCategory.Action" class="nav-link">
                                        <i class="@tempAnonymousCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAnonymousCategory.DisplayName]
                                        </p>
                                    </a>
                                </li>
                            }
                        }
                        else if (string.IsNullOrEmpty(tempAnonymousCategory.Action)) // Multi-level category (has subcategories)
                        {
                            IOrderedEnumerable<SubCategoryResponse> tempAnonymousSelectedSubCategories = from tempAnonymousSubCategory in tempAnonymousSubCategories
                                                                                                 where tempAnonymousCategory.Id == tempAnonymousSubCategory.CategoryId
                                                                                                 orderby tempAnonymousSubCategory.Order ascending
                                                                                                 select tempAnonymousSubCategory;

                            bool isExistSelectedSubCategoryInCategory = false;

                            foreach (SubCategoryResponse tempUserSelectedSubCategory in tempAnonymousSelectedSubCategories)
                            {
                                if (tempAnonymousCategory.Controller == currentControllerName && tempUserSelectedSubCategory.Action == currentActionName)
                                {
                                    isExistSelectedSubCategoryInCategory = true;
                                    break;
                                }
                            }

                            if (isExistSelectedSubCategoryInCategory == true)
                            {
                                <li class="nav-item menu-open">
                                    <a href="#" class="nav-link active">
                                        <i class="@tempAnonymousCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAnonymousCategory.DisplayName]
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempAnonymousSelectedSubCategory in tempAnonymousSelectedSubCategories)
                                        {
                                            if (tempAnonymousSelectedSubCategory.Action == currentActionName)
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAnonymousCategory.Controller" asp-action="@tempAnonymousSelectedSubCategory.Action" class="nav-link active">
                                                        <i class="@tempAnonymousSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempAnonymousSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li class="nav-item">
                                                    <a asp-controller="@tempAnonymousCategory.Controller" asp-action="@tempAnonymousSelectedSubCategory.Action" class="nav-link">
                                                        <i class="@tempAnonymousSelectedSubCategory.IconPath"></i>
                                                        <p>@localizer[tempAnonymousSelectedSubCategory.DisplayName]</p>
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (isExistSelectedSubCategoryInCategory == false)
                            {
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="@tempAnonymousCategory.IconPath"></i>
                                        <p>
                                            @localizer[tempAnonymousCategory.DisplayName]
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        @foreach (SubCategoryResponse tempAnonymousSelectedSubCategory in tempAnonymousSelectedSubCategories)
                                        {
                                            <li class="nav-item">
                                                <a asp-controller="@tempAnonymousCategory.Controller" asp-action="@tempAnonymousSelectedSubCategory.Action" class="nav-link">
                                                    <i class="@tempAnonymousSelectedSubCategory.IconPath"></i>
                                                    <p>@localizer[tempAnonymousSelectedSubCategory.DisplayName]</p>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    }
                }
                else // Should never reach here.
                {

                }
            </ul>
        </nav>
    </div>
</aside>