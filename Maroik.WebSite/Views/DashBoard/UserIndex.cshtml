@using Maroik.WebSite.Models.ViewModels.DashBoard

@model UserIndexOutputViewModel

@{

    int startYear = Convert.ToInt32((ViewBag.StartYear as string) ?? "");
    int endYear = DateTime.UtcNow.Year;
    int selectedYear = Convert.ToInt32((ViewBag.SelectedYear as string) ?? "");
    int selectedMonth = Convert.ToInt32((ViewBag.SelectedMonth as string) ?? "");

    string currentCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>().RequestCulture.Culture.Name;

    decimal regularIncomeTotal = 0;
    decimal regularIncomeLaborIncome = 0;
    decimal regularIncomeBusinessIncome = 0;
    decimal regularIncomePensionIncome = 0;
    decimal regularIncomeFinancialIncome = 0;
    decimal regularIncomeRentalIncome = 0;
    decimal regularIncomeOtherIncome = 0;

    double percetageOfRegularIncomeLaborIncome = 0;
    double percetageOfRegularIncomeBusinessIncome = 0;
    double percetageOfRegularIncomePensionIncome = 0;
    double percetageOfRegularIncomeFinancialIncome = 0;
    double percetageOfRegularIncomeRentalIncome = 0;
    double percetageOfRegularIncomeOtherIncome = 0;

    decimal? regularIncomeModeValue = null;
    long? regularIncomeModeCount = null;

    decimal irregularIncomeTotal = 0;
    decimal irregularIncomeLaborIncome = 0;
    decimal irregularIncomeOtherIncome = 0;

    double percentageOfIrregularIncomeLaborIncome = 0;
    double percentageOfIrregularIncomeOtherIncome = 0;

    decimal? irregularIncomeModeValue = null;
    long? irregularIncomeModeCount = null;

    decimal regularSavingsTotal = 0;
    decimal regularSavingsDeposit = 0;
    decimal regularSavingsInvestment = 0;

    double percentageOfRegularSavingsDeposit = 0;
    double percentageOfRegularSavingsInvestment = 0;

    decimal? regularSavingsModeValue = null;
    long? regularSavingsModeCount = null;

    decimal nonConsumerSpendingTotal = 0;
    decimal nonConsumerSpendingPublicPension = 0;
    decimal nonConsumerSpendingDebtRepayment = 0;
    decimal nonConsumerSpendingTax = 0;
    decimal nonConsumerSpendingSocialInsurance = 0;
    decimal nonConsumerSpendingInterHouseholdTranserExpenses = 0;
    decimal nonConsumerSpendingNonProfitOrganizationTransfer = 0;

    double percentageOfNonConsumerSpendingPublicPension = 0;
    double percentageOfNonConsumerSpendingDebtRepayment = 0;
    double percentageOfNonConsumerSpendingTax = 0;
    double percentageOfNonConsumerSpendingSocialInsurance = 0;
    double percentageOfNonConsumerSpendingInterHouseholdTranserExpenses = 0;
    double percentageOfNonConsumerSpendingNonProfitOrganizationTransfer = 0;

    decimal? nonConsumerSpendingModeValue = null;
    long? nonConsumerSpendingModeCount = null;

    decimal consumerSpendingTotal = 0;
    decimal consumerSpendingMealOrEatOutExpenses = 0;
    decimal consumerSpendingHousingOrSuppliesCost = 0;
    decimal consumerSpendingEducationExpenses = 0;
    decimal consumerSpendingMedicalExpenses = 0;
    decimal consumerSpendingTransportationCost = 0;
    decimal consumerSpendingCommunicationCost = 0;
    decimal consumerSpendingLeisureOrCulture = 0;
    decimal consumerSpendingClothingOrShoes = 0;
    decimal consumerSpendingPinMoney = 0;
    decimal consumerSpendingProtectionTypeInsurance = 0;
    decimal consumerSpendingOtherExpenses = 0;
    decimal consumerSpendingUnknownExpenditure = 0;

    double percentageOfConsumerSpendingMealOrEatOutExpenses = 0;
    double percentageOfConsumerSpendingHousingOrSuppliesCost = 0;
    double percentageOfConsumerSpendingEducationExpenses = 0;
    double percentageOfConsumerSpendingMedicalExpenses = 0;
    double percentageOfConsumerSpendingTransportationCost = 0;
    double percentageOfConsumerSpendingCommunicationCost = 0;
    double percentageOfConsumerSpendingLeisureOrCulture = 0;
    double percentageOfConsumerSpendingClothingOrShoes = 0;
    double percentageOfConsumerSpendingPinMoney = 0;
    double percentageOfConsumerSpendingProtectionTypeInsurance = 0;
    double percentageOfConsumerSpendingOtherExpenses = 0;
    double percentageOfConsumerSpendingUnknownExpenditure = 0;

    decimal? consumerSpendingModeValue = null;
    long? consumerSpendingModeCount = null;

    if (Model.DefaultMonetaryUnit != null)
    {
        #region 수입

        #region 대분류 = '정기수입'
        List<IncomeOutputViewModel> regularIncome = Model.IncomeOutputViewModels.Where(x => x.MainClass == "RegularIncome").ToList();

        regularIncomeTotal = regularIncome.Sum(v => v.Amount);
        regularIncomeLaborIncome = regularIncome.Where(x => x.SubClass == "LaborIncome").Sum(v => v.Amount);
        regularIncomeBusinessIncome = regularIncome.Where(x => x.SubClass == "BusinessIncome").Sum(v => v.Amount);
        regularIncomePensionIncome = regularIncome.Where(x => x.SubClass == "PensionIncome").Sum(v => v.Amount);
        regularIncomeFinancialIncome = regularIncome.Where(x => x.SubClass == "FinancialIncome").Sum(v => v.Amount);
        regularIncomeRentalIncome = regularIncome.Where(x => x.SubClass == "RentalIncome").Sum(v => v.Amount);
        regularIncomeOtherIncome = regularIncome.Where(x => x.SubClass == "OtherIncome").Sum(v => v.Amount);

        if (regularIncomeTotal != 0)
        {
            percetageOfRegularIncomeLaborIncome = ((double)(100)) * (((double)regularIncomeLaborIncome) / ((double)regularIncomeTotal));
            percetageOfRegularIncomeBusinessIncome = ((double)(100)) * (((double)regularIncomeBusinessIncome) / ((double)regularIncomeTotal));
            percetageOfRegularIncomePensionIncome = ((double)(100)) * (((double)regularIncomePensionIncome) / ((double)regularIncomeTotal));
            percetageOfRegularIncomeFinancialIncome = ((double)(100)) * (((double)regularIncomeFinancialIncome) / ((double)regularIncomeTotal));
            percetageOfRegularIncomeRentalIncome = ((double)(100)) * (((double)regularIncomeRentalIncome) / ((double)regularIncomeTotal));
            percetageOfRegularIncomeOtherIncome = ((double)(100)) * (((double)regularIncomeOtherIncome) / ((double)regularIncomeTotal));
        }

        var regularIncomeModeGroup = regularIncome
            ?.GroupBy(x => x.Amount)
            ?.OrderByDescending(g => g.Count()) // 빈도 수 기준 내림차순 정렬
            ?.ThenBy(g => g.Key) // 빈도 수가 같다면 Amount 기준 오름차순 정렬
            ?.FirstOrDefault() ?? null;

        regularIncomeModeValue = regularIncomeModeGroup?.Key ?? null; // 최빈값 (가장 자주 등장하는 최소 Amount 값)
        regularIncomeModeCount = regularIncomeModeGroup?.Count() ?? null;  // 최빈값의 갯수
        #endregion

        #region 대분류 = '비정기수입'
        List<IncomeOutputViewModel> irregularIncome = Model.IncomeOutputViewModels.Where(x => x.MainClass == "IrregularIncome").ToList();

        irregularIncomeTotal = irregularIncome.Sum(v => v.Amount);
        irregularIncomeLaborIncome = irregularIncome.Where(x => x.SubClass == "LaborIncome").Sum(v => v.Amount);
        irregularIncomeOtherIncome = irregularIncome.Where(x => x.SubClass == "OtherIncome").Sum(v => v.Amount);

        if (irregularIncomeTotal != 0)
        {
            percentageOfIrregularIncomeLaborIncome = ((double)(100)) * (((double)irregularIncomeLaborIncome) / ((double)irregularIncomeTotal));
            percentageOfIrregularIncomeOtherIncome = ((double)(100)) * (((double)irregularIncomeOtherIncome) / ((double)irregularIncomeTotal));
        }

        var irregularIncomeModeGroup = irregularIncome
            ?.GroupBy(x => x.Amount)
            ?.OrderByDescending(g => g.Count()) // 빈도 수 기준 내림차순 정렬
            ?.ThenBy(g => g.Key) // 빈도 수가 같다면 Amount 기준 오름차순 정렬
            ?.FirstOrDefault() ?? null;

        irregularIncomeModeValue = irregularIncomeModeGroup?.Key ?? null; // 최빈값 (가장 자주 등장하는 최소 Amount 값)
        irregularIncomeModeCount = irregularIncomeModeGroup?.Count() ?? null;  // 최빈값의 갯수
        #endregion

        #endregion

        #region 지출

        #region 대분류 = '정기저축'
        List<ExpenditureOutputViewModel> regularSavings = Model.ExpenditureOutputViewModels.Where(x => x.MainClass == "RegularSavings").ToList();

        regularSavingsTotal = regularSavings.Sum(v => v.Amount);
        regularSavingsDeposit = regularSavings.Where(x => x.SubClass == "Deposit").Sum(v => v.Amount);
        regularSavingsInvestment = regularSavings.Where(x => x.SubClass == "Investment").Sum(v => v.Amount);

        if (regularSavingsTotal != 0)
        {
            percentageOfRegularSavingsDeposit = ((double)(100)) * (((double)regularSavingsDeposit) / ((double)regularSavingsTotal));
            percentageOfRegularSavingsInvestment = ((double)(100)) * (((double)regularSavingsInvestment) / ((double)regularSavingsTotal));
        }

        var regularSavingsModeGroup = regularSavings
            ?.GroupBy(x => x.Amount)
            ?.OrderByDescending(g => g.Count()) // 빈도 수 기준 내림차순 정렬
            ?.ThenBy(g => g.Key) // 빈도 수가 같다면 Amount 기준 오름차순 정렬
            ?.FirstOrDefault() ?? null;

        regularSavingsModeValue = regularSavingsModeGroup?.Key ?? null; // 최빈값 (가장 자주 등장하는 최소 Amount 값)
        regularSavingsModeCount = regularSavingsModeGroup?.Count() ?? null;  // 최빈값의 갯수
        #endregion

        #region 대분류 = '비소비지출'
        List<ExpenditureOutputViewModel> nonConsumerSpending = Model.ExpenditureOutputViewModels.Where(x => x.MainClass == "NonConsumerSpending").ToList();

        nonConsumerSpendingTotal = nonConsumerSpending.Sum(v => v.Amount);
        nonConsumerSpendingPublicPension = nonConsumerSpending.Where(x => x.SubClass == "PublicPension").Sum(v => v.Amount);
        nonConsumerSpendingDebtRepayment = nonConsumerSpending.Where(x => x.SubClass == "DebtRepayment").Sum(v => v.Amount);
        nonConsumerSpendingTax = nonConsumerSpending.Where(x => x.SubClass == "Tax").Sum(v => v.Amount);
        nonConsumerSpendingSocialInsurance = nonConsumerSpending.Where(x => x.SubClass == "SocialInsurance").Sum(v => v.Amount);
        nonConsumerSpendingInterHouseholdTranserExpenses = nonConsumerSpending.Where(x => x.SubClass == "InterHouseholdTranserExpenses").Sum(v => v.Amount);
        nonConsumerSpendingNonProfitOrganizationTransfer = nonConsumerSpending.Where(x => x.SubClass == "NonProfitOrganizationTransfer").Sum(v => v.Amount);

        if (nonConsumerSpendingTotal != 0)
        {
            percentageOfNonConsumerSpendingPublicPension = ((double)(100)) * (((double)nonConsumerSpendingPublicPension) / ((double)nonConsumerSpendingTotal));
            percentageOfNonConsumerSpendingDebtRepayment = ((double)(100)) * (((double)nonConsumerSpendingDebtRepayment) / ((double)nonConsumerSpendingTotal));
            percentageOfNonConsumerSpendingTax = ((double)(100)) * (((double)nonConsumerSpendingTax) / ((double)nonConsumerSpendingTotal));
            percentageOfNonConsumerSpendingSocialInsurance = ((double)(100)) * (((double)nonConsumerSpendingSocialInsurance) / ((double)nonConsumerSpendingTotal));
            percentageOfNonConsumerSpendingInterHouseholdTranserExpenses = ((double)(100)) * (((double)nonConsumerSpendingInterHouseholdTranserExpenses) / ((double)nonConsumerSpendingTotal));
            percentageOfNonConsumerSpendingNonProfitOrganizationTransfer = ((double)(100)) * (((double)nonConsumerSpendingNonProfitOrganizationTransfer) / ((double)nonConsumerSpendingTotal));
        }

        var nonConsumerSpendingModeGroup = nonConsumerSpending
            ?.GroupBy(x => x.Amount)
            ?.OrderByDescending(g => g.Count()) // 빈도 수 기준 내림차순 정렬
            ?.ThenBy(g => g.Key) // 빈도 수가 같다면 Amount 기준 오름차순 정렬
            ?.FirstOrDefault() ?? null;

        nonConsumerSpendingModeValue = nonConsumerSpendingModeGroup?.Key ?? null; // 최빈값 (가장 자주 등장하는 최소 Amount 값)
        nonConsumerSpendingModeCount = nonConsumerSpendingModeGroup?.Count() ?? null;  // 최빈값의 갯수
        #endregion

        #region 대분류 = '소비지출'
        List<ExpenditureOutputViewModel> consumerSpending = Model.ExpenditureOutputViewModels.Where(x => x.MainClass == "ConsumerSpending").ToList();

        consumerSpendingTotal = consumerSpending.Sum(v => v.Amount);
        consumerSpendingMealOrEatOutExpenses = consumerSpending.Where(x => x.SubClass == "MealOrEatOutExpenses").Sum(v => v.Amount);
        consumerSpendingHousingOrSuppliesCost = consumerSpending.Where(x => x.SubClass == "HousingOrSuppliesCost").Sum(v => v.Amount);
        consumerSpendingEducationExpenses = consumerSpending.Where(x => x.SubClass == "EducationExpenses").Sum(v => v.Amount);
        consumerSpendingMedicalExpenses = consumerSpending.Where(x => x.SubClass == "MedicalExpenses").Sum(v => v.Amount);
        consumerSpendingTransportationCost = consumerSpending.Where(x => x.SubClass == "TransportationCost").Sum(v => v.Amount);
        consumerSpendingCommunicationCost = consumerSpending.Where(x => x.SubClass == "CommunicationCost").Sum(v => v.Amount);
        consumerSpendingLeisureOrCulture = consumerSpending.Where(x => x.SubClass == "LeisureOrCulture").Sum(v => v.Amount);
        consumerSpendingClothingOrShoes = consumerSpending.Where(x => x.SubClass == "ClothingOrShoes").Sum(v => v.Amount);
        consumerSpendingPinMoney = consumerSpending.Where(x => x.SubClass == "PinMoney").Sum(v => v.Amount);
        consumerSpendingProtectionTypeInsurance = consumerSpending.Where(x => x.SubClass == "ProtectionTypeInsurance").Sum(v => v.Amount);
        consumerSpendingOtherExpenses = consumerSpending.Where(x => x.SubClass == "OtherExpenses").Sum(v => v.Amount);
        consumerSpendingUnknownExpenditure = consumerSpending.Where(x => x.SubClass == "UnknownExpenditure").Sum(v => v.Amount);

        if (consumerSpendingTotal != 0)
        {
            percentageOfConsumerSpendingMealOrEatOutExpenses = ((double)(100)) * (((double)consumerSpendingMealOrEatOutExpenses) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingHousingOrSuppliesCost = ((double)(100)) * (((double)consumerSpendingHousingOrSuppliesCost) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingEducationExpenses = ((double)(100)) * (((double)consumerSpendingEducationExpenses) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingMedicalExpenses = ((double)(100)) * (((double)consumerSpendingMedicalExpenses) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingTransportationCost = ((double)(100)) * (((double)consumerSpendingTransportationCost) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingCommunicationCost = ((double)(100)) * (((double)consumerSpendingCommunicationCost) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingLeisureOrCulture = ((double)(100)) * (((double)consumerSpendingLeisureOrCulture) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingClothingOrShoes = ((double)(100)) * (((double)consumerSpendingClothingOrShoes) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingPinMoney = ((double)(100)) * (((double)consumerSpendingPinMoney) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingProtectionTypeInsurance = ((double)(100)) * (((double)consumerSpendingProtectionTypeInsurance) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingOtherExpenses = ((double)(100)) * (((double)consumerSpendingOtherExpenses) / ((double)consumerSpendingTotal));
            percentageOfConsumerSpendingUnknownExpenditure = ((double)(100)) * (((double)consumerSpendingUnknownExpenditure) / ((double)consumerSpendingTotal));
        }

        var consumerSpendingModeGroup = consumerSpending
            ?.GroupBy(x => x.Amount)
            ?.OrderByDescending(g => g.Count()) // 빈도 수 기준 내림차순 정렬
            ?.ThenBy(g => g.Key) // 빈도 수가 같다면 Amount 기준 오름차순 정렬
            ?.FirstOrDefault() ?? null;

        consumerSpendingModeValue = consumerSpendingModeGroup?.Key ?? null; // 최빈값 (가장 자주 등장하는 최소 Amount 값)
        consumerSpendingModeCount = consumerSpendingModeGroup?.Count() ?? null;  // 최빈값의 갯수
        #endregion

        #endregion
    }
}

