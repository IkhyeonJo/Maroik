@using Maroik.WebSite.Models.ViewModels.Forum

@model FreeBoardOutputViewModel

@{
    #region 자유게시판

    var boards = Model.Boards;

    #endregion
}

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Free Forum</h3>
        </div>
        <div class="card-body">
            @foreach (var board in boards)
            {
                <div>@board.Id</div>
                <div>@board.Title</div>
                <div>@board.Writer</div>
                <div>@board.Created</div>
                <div>@board.Updated</div>
            }
        </div>
    </div>
</section>