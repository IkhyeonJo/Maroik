@using Maroik.WebSite.Common
@using Maroik.WebSite.Models
@using Maroik.WebSite.Models.ViewModels.Forum

@model FreeForumOutputViewModel

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Free Forum</h3>
        </div>
        <div class="card-body">
            @if (Model.Method == "write")
            {
                <form id="formWriteBoard" onsubmit="return WriteBoard()">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label for="writeBoardTitle">Title</label>
                        <input class="form-control" type="text" data-val="true" data-val-required="Title is required" id="writeBoardTitle" name="writeBoardTitle" value="" required maxlength="30">
                        <span class="field-validation-valid text-danger" data-valmsg-for="writeBoardTitle" data-valmsg-replace="true"></span>
                    </div>
                    <div class="form-group">
                        <label for="writeBoardContent" class="control-label"></label>
                        <textarea name="writeBoardContent" id="writeBoardContent" maxlength="16384"></textarea> @*maxlength: 16KB*@
                    </div>

                    <div class="form-group">
                        <input type="file" id="uploadedFile" name="uploadedFile" accept=".zip">
                        <p class="help-block">Only zip extension allowed.</p>
                    </div>

                    <div class="form-group">
                        <div class="float-right">
                            <button type="submit" class="btn btn-primary" onclick="return ShowLoginLoading()">등록</button>
                        </div>
                        <a asp-controller="Forum" asp-action="FreeForum" class="btn btn-default">목록</a>
                    </div>
                </form>
            }
            else if (Model.Method == "detail")
            {
                <h5 class="card-title" >@Model.BoardOutputViewModel.Title</h5>
                <br/>
                <br/>
                <div class="card-text">
                    @Html.Raw(Model.BoardOutputViewModel.Content)
                </div>
            }
            else
            {
                <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                    <ul class="navbar-nav">
                        <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                            <button type="button" class="btn btn-success btn-block btn-sm" onclick="location.href='/Forum/FreeForum?method=write'" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> 글쓰기</button>
                        </li>
                        <li class="nav-item ml-auto">
                            <input type="text" id="gridSearch" placeholder="검색..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                        </li>
                    </ul>
                </nav>

                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>번호</th>
                            <th>제목</th>
                            <th>작성자</th>
                            <th>날짜</th>
                            <th>조회수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var board in Model.Boards)
                        {
                            <tr>
                                <td>@board.Id</td>

                                @if (board.Title.Length > 10)
                                {
                                    <td>@Html.ActionLink(($"{board.Title.Substring(0, 10)}..."), "FreeForum", new {method = "detail", boardId = board.Id})</td>
                                }
                                else
                                {
                                    <td>@Html.ActionLink(@board.Title, "FreeForum", new {method = "detail", boardId = board.Id})</td>
                                }

                                <td>@board.Writer</td>
                                <td>@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(board.Created, OSTimeZone.DestinationTimeZoneId)</td>
                                <td>@board.Views</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />

                <nav aria-label="Page navigation example">
                    @if (Model.Pager.TotalPages > 0)
                    {
                        <ul class="pagination justify-content-center">

                            @if (Model.Pager.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="1">&lt;&lt;</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.CurrentPage-1)">&lt;</a>
                                </li>
                            }

                            @for (var pageNumber = Model.Pager.StartPage; pageNumber <= Model.Pager.EndPage; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.Pager.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@pageNumber">@pageNumber</a>
                                </li>
                            }

                            @if (Model.Pager.CurrentPage < Model.Pager.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.CurrentPage + 1)">&gt;</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.TotalPages)">&gt;&gt;</a>
                                </li>
                            }
                        </ul>
                    }
                </nav>
            }
        </div>
    </div>
</section>

<div class="modal" id="loading">
    <img src="~/upload/Forum/ajax-loader.gif" />
</div>

@section Scripts {
    <script>
        function ShowLoginLoading() {
            if (!$('#formWriteBoard').valid()) {
                $('#loading').hide();
                return false;
            }
            else {
                $('#loading').show();
                return true;
            }
        }

        var uploadedFile;

        $("#uploadedFile").on("change", function (event) {
            if (event.target.files[0].size > 10485760) {
                alert('File size must be smaller than 10MB');
                document.getElementById("uploadedFile").value = "";
                return false;
            }
            else {
                uploadedFile = event.target.files[0];
            }
        });

        $('#writeBoardContent').summernote({
            height: 300,
            callbacks: {
                onImageUpload: function (files) {
                    for (let i = 0; i < files.length; i++) {
                        UploadImageFile(files[i]);
                    }
                }
            }
        });

        function UploadImageFile(file) {

            formData = new FormData();
            formData.append("summernoteImageFile", file);

            $.ajax({
                url: "/Forum/UploadImageFile",
                data: formData,
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                type: 'POST',
                enctype: 'multipart/form-data',
                processData: false,
                contentType: false,
                dataType: 'json',
                cache: false,
                success: function (data) {
                    if (data.result) {
                        var imgNode = document.createElement('img');
                        imgNode.src = data.filePath;
                        $('#writeBoardContent').summernote('insertNode', imgNode);
                    }
                    else {
                        alert(data.errorMessage);
                    }
                }
            });
        }

        function WriteBoard() {

            if (!$('#formWriteBoard').valid()) {
                return false;
            }

            var createForm = $('#formWriteBoard');

            var title = createForm.find('input[id="writeBoardTitle"]').val();
            var content = createForm.find('textarea[id="writeBoardContent"]').val();

            var formData = new FormData();
            formData.append('Title', title);
            formData.append('Content', content);
            formData.append('UploadedFile', uploadedFile);


            $.ajax({
                url: '/Forum/WriteFreeBoard',
                type: 'POST',
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                dataType: 'json',
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    if (data.result) {
                        alert(data.message);
                        window.location.href = "/Forum/FreeForum";
                    }
                    else {
                        toastr.error(data.error);
                    }
                }
            });

            return false;
        }
    </script>
}