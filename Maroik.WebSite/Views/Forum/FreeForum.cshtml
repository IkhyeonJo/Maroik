@using Maroik.WebSite.Models
@using Maroik.WebSite.Models.ViewModels.Forum

@model FreeForumOutputViewModel

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Free Forum</h3>
        </div>
        <div class="card-body">
            @if (Model.Method == "write")
            {
                <form asp-controller="Forum" asp-action="WriteBoard" enctype="multipart/form-data" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="BoardOutputViewModel.Title" class="control-label"></label>
                        <input asp-for="BoardOutputViewModel.Title" type="text" class="form-control" required/>
                        <span asp-validation-for="BoardOutputViewModel.Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BoardOutputViewModel.Content" class="control-label"></label>
                        <textarea asp-for="BoardOutputViewModel.Content" id="summernote"></textarea>
                        <span asp-validation-for="BoardOutputViewModel.Content" class="text-danger"></span>
                    </div>

                    @*                    
                    <div class="form-group">
                        <div class="btn btn-default btn-file">
                            <i class="fas fa-paperclip"></i> Attachment
                            <input type="file" name="attachment">
                        </div>
                        <p class="help-block">Max. 32MB</p>
                    </div>
                    *@
                    <div class="form-group">
                        <div class="float-right">
                            <button type="submit" class="btn btn-primary">등록</button>
                        </div>
                        @*<button type="reset" class="btn btn-default"><i class="fas fa-times"></i> Discard</button>*@
                        <a asp-controller="Forum" asp-action="FreeForum" class="btn btn-default">목록</a>
                    </div>
                </form>
            }
            else
            {
                <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                    <ul class="navbar-nav">
                        <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                            <button type="button" class="btn btn-success btn-block btn-sm" onclick="location.href='/Forum/FreeForum?method=write'" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> 글쓰기</button>
                        </li>
                        <li class="nav-item ml-auto">
                            <input type="text" id="gridSearch" placeholder="검색..." style="margin-bottom: 7px; text-align: center; font-size: .7em; padding: 5px 0; color: #000; border: none; " />
                        </li>
                    </ul>
                </nav>

                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>번호</th>
                            <th>제목</th>
                            <th>작성자</th>
                            <th>날짜</th>
                            <th>조회수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var board in Model.Boards)
                        {
                            <tr>
                                <td>@board.Id</td>
                                <td>@board.Title</td>
                                <td>@board.Writer</td>
                                <td>@board.Created</td>
                                <td>@board.Views</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />

                <nav aria-label="Page navigation example">
                    @if (Model.Pager.TotalPages > 0)
                    {
                        <ul class="pagination justify-content-center">

                            @if (Model.Pager.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="1">&lt;&lt;</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.CurrentPage-1)">&lt;</a>
                                </li>
                            }

                            @for (var pageNumber = Model.Pager.StartPage; pageNumber <= Model.Pager.EndPage; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.Pager.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@pageNumber">@pageNumber</a>
                                </li>
                            }

                            @if (Model.Pager.CurrentPage < Model.Pager.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.CurrentPage + 1)">&gt;</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-page="@(Model.Pager.TotalPages)">&gt;&gt;</a>
                                </li>
                            }
                        </ul>
                    }
                </nav>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $('#summernote').summernote({
            //placeholder: 'Post Something....',
            //tabsize: 10,
            height: 300,
            callbacks: {
                onImageUpload: function (files) {
                    for (let i = 0; i < files.length; i++) {
                        UploadImageFile(files[i]);
                    }
                }
            }
        });

        function UploadImageFile(file) {

            formData = new FormData();
            formData.append("summernoteImageFile", file);

            $.ajax({
                url: "/Forum/UploadImageFile",
                data: formData,
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                type: 'POST',
                enctype: 'multipart/form-data',
                processData: false,
                contentType: false,
                dataType: 'json',
                cache: false,
                success: function (data) {
                    if (data.result) {
                        var imgNode = document.createElement('img');
                        imgNode.src = data.filePath;
                        $('#summernote').summernote('insertNode', imgNode);
                    }
                    else {
                        alert(data.errorMessage);
                    }
                }
            });
        }
    </script>
}