@using Maroik.WebSite.Models
@using Maroik.WebSite.Models.ViewModels.Forum

@model IEnumerable<Board>

@{
    Pager pager = new Pager();

    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">Free Forum</h3>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>번호</th>
                        <th>제목</th>
                        <th>작성자</th>
                        <th>날짜</th>
                        <th>조회수</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var board in Model)
                    {
                        <tr>
                            <td>@board.Id</td>
                            <td>@board.Title</td>
                            <td>@board.Writer</td>
                            <td>@board.Created</td>
                            <td>@board.Views</td>
                        </tr>
                    }
                </tbody>
            </table>
            <hr/>
            

            <div class="container">
                @if(pager.TotalPages > 0)
                {
                    <ul class="pagination justify-content-end">

                        @if (pager.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-pg="1">First</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-pg="@(pager.CurrentPage-1)">Previous</a>
                            </li>
                        }


                        @for(var pge = pager.StartPage; pge <= pager.EndPage; pge++)
                        {
                            <li class="page-item @(pge == pager.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-pg="@pge">@pge</a>
                            </li>
                        }

                        @if (pager.CurrentPage < pager.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-pg="@(pager.CurrentPage + 1)">Next</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" asp-controller="Forum" asp-action="FreeForum" asp-route-pg="@(pager.TotalPages)">Last</a>
                            </li>
                        }
                    </ul>
                }
            </div>

        </div>
    </div>
</section>