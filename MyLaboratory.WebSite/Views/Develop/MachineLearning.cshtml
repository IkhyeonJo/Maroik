@Html.AntiForgeryToken()
<section class="content">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">MachineLearning</h3>
        </div>

        <div class="card-body">
            <nav class="navbar-expand navbar-dark" style="position: relative; display: block !important; overflow-x: auto; overflow-y:hidden; align-items: center ">
                <ul class="navbar-nav">
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <form id="formUploadMLModelData" method="POST" enctype="multipart/form-data">
                            <div class="form-group">
                                <div class="btn btn-default btn-file">
                                    <i class="fas fa-paperclip" style="padding-right: 3px;"></i>&nbsp;&nbsp;&nbsp;@localizer["Browse"]
                                    <input type="file" name="MLModelDataFiles" id="MLModelDataFiles" onchange="return UploadMLModelData('@localizer["Please attach a file."]', '@localizer["File Size must be smaller than 10MB."]', '@localizer["Only .csv file allowed."]');" accept=".csv">
                                </div>
                            </div>
                        </form>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-success btn-block btn-sm" onclick="EditMenuGridRow('@localizer["Please select grid row"].Value')" style="width: 100px !important;"><i class="fas fa-edit" style="padding-right:3px;"></i> @localizer["Modeling"].Value</button>
                    </li>
                    <li class="nav-item" style="padding-bottom: 10px; padding-right: 7px;">
                        <button type="button" class="btn btn-danger btn-block btn-sm" onclick="ConfirmDeleteMenu('@localizer["Please select grid row"].Value')" style="width: 100px !important;"><i class="fa fa-trash" style="padding-right:3px;"></i> @localizer["Predict"].Value</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</section>

@section Scripts{
    <script src="~/admin/custom/Develop/MachineLearning/js/site.js" asp-append-version="true"></script>
}