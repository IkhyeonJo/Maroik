@Html.Hidden("MyValue",123)

<section class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-1"></i>
                            금월 수입
                        </h3>
                        <div class="card-tools">
                            <ul class="nav nav-pills ml-auto">
                                <li class="nav-item">
                                    <a class="nav-link active" href="#dashboardIncomeTabs-1" data-toggle="tab">Regular income</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#dashboardIncomeTabs-2" data-toggle="tab">Irregular income</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="tab-content p-0">
                            <div class="chart tab-pane active" id="dashboardIncomeTabs-1" style="position: relative; height: 300px;">
                                <canvas id="regularIncome" style="min-height: 300px; height: 300px; max-height: 300px; max-width: 100%;"></canvas>
                            </div>
                            <div class="chart tab-pane" id="dashboardIncomeTabs-2" style="position: relative; height: 300px;">
                                금월 비정기 수입 Donut
                                @*<canvas id="sales-chart-canvas" height="300" style="height: 300px;"></canvas>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-1"></i>
                            금월 지출
                        </h3>
                        <div class="card-tools">
                            <ul class="nav nav-pills ml-auto">
                                <li class="nav-item">
                                    <a class="nav-link active" href="#dashboardExpenditureTabs-1" data-toggle="tab">Regular savings</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#dashboardExpenditureTabs-2" data-toggle="tab">NonConsumer spending</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#dashboardExpenditureTabs-3" data-toggle="tab">Consumer spending</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="tab-content p-0">
                            <div class="chart tab-pane active" id="dashboardExpenditureTabs-1" style="position: relative; height: 300px;">
                                금월 정기저축 Donut
                                @*<canvas id="revenue-chart-canvas" height="300" style="height: 300px;"></canvas>*@
                            </div>
                            <div class="chart tab-pane" id="dashboardExpenditureTabs-2" style="position: relative; height: 300px;">
                                금월 비소비지출 Donut
                                @*<canvas id="sales-chart-canvas" height="300" style="height: 300px;"></canvas>*@
                            </div>
                            <div class="chart tab-pane" id="dashboardExpenditureTabs-3" style="position: relative; height: 300px;">
                                금월 소비지출 Donut
                                @*<canvas id="sales-chart-canvas" height="300" style="height: 300px;"></canvas>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
@section Scripts{
<script src="~/user/custom/DashBoard/UserIndex/js/site.js" asp-append-version="true"></script>
}