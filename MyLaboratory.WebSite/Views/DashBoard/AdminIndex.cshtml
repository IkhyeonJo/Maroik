@{
    #region Sales
    float[] forecastResult = ViewBag.ForecastResult ?? null;
    List<int> intForecastResult = new List<int>();

    foreach(float item in forecastResult)
    {
        intForecastResult.Add((int)item);
    }

    int thisWeekTotalForecastResult = 0;

    foreach(int item in intForecastResult)
    {
        thisWeekTotalForecastResult += item;
    }

    int pastWeekTotalForecastResult = 4924500 + 4158400 + 5254290 + 6519700 + 5140370 + 4109500 + 2471600;

    var percentage = (double)(((double)(thisWeekTotalForecastResult - pastWeekTotalForecastResult) / (double)(pastWeekTotalForecastResult)) * 100);

    Int64 lastYearDiaperPantySales = 1005816920;
    Int64 currentYearDiaperPantySales = 1509708210;
    Int64 totalDiaperPantySales = lastYearDiaperPantySales + currentYearDiaperPantySales;

    var percentageOfSales = (double)(((double)(currentYearDiaperPantySales - lastYearDiaperPantySales) / (double)(lastYearDiaperPantySales)) * 100);
    #endregion

    #region Stocks
    float[] forecastStockResult = ViewBag.ForecastStockResult ?? null;
    List<int> intForecastStockResult = new List<int>();

    foreach(float item in forecastStockResult)
    {
        intForecastStockResult.Add((int)item);
    }

    int thisWeekTotalForecastStockResult = 0;

    foreach(int item in intForecastStockResult)
    {
        thisWeekTotalForecastStockResult += item;
    }

    int pastWeekTotalForecastStockResult = 89 + 75 + 95 + 123 + 93 + 76 + 51;

    var percentageStock = (double)(((double)(thisWeekTotalForecastStockResult - pastWeekTotalForecastStockResult) / (double)(pastWeekTotalForecastStockResult)) * 100);

    Int64 lastYearDiaperPantyStock = 912+1271+1585+2082+2890+3191+4114;
    Int64 currentYearDiaperPantyStock = 4560+41110+3105+3442+3128+2177+3185;
    Int64 totalDiaperPantyStock = lastYearDiaperPantyStock + currentYearDiaperPantyStock;

    var percentageOfStocks = (double)(((double)(currentYearDiaperPantyStock - lastYearDiaperPantyStock) / (double)(lastYearDiaperPantyStock)) * 100);
    #endregion
}
@Html.Hidden("intForecastResult0",intForecastResult[0])
