<script>
    function GotoIndex() {
        window.location.href = "@Url.Action("CoreValueEdit", "Admin")";
    }
    function Save() {
        if (!IsTeamNumberExist()) {
            var paramValue = JSON.stringify({
                TeamNumber: 11,
                Evaluator: 'Evaluator33',
                CategoryOne0: 22,
                CategoryOne1: 33,
                CategoryOne2: 44,
                CategoryTwo0: 55,
                CategoryTwo1: 66,
                CategoryTwo2: 77,
                CategoryThree0: 88,
                CategoryThree1: 99,
                CategoryThree2: 100,
                CategoryScore: 1000,
                GoodText: 'GoodText0',
                Opinion: 'Opinion1',
                BeforeTeamNumber: @ViewBag.BeforeTeamNumber
            });
            $.ajax({
                url: '@Url.Action("CoreValueEdit", "Admin")',
                type: 'POST',
                dataType: 'json',
                data: paramValue,
                contentType: 'application/json; charset=utf-8',
                async: false,
                cache: false,
                success: function (data) {
                    if (data.result) {
                        window.location.href = "@Url.Action("CoreValue", "Admin")";
                    }
                    else {
                        alert('저장에 실패하였습니다. 잠시 후 다시 시도해주시길 바랍니다.');
                    }
                }
            });
        } else {
            alert('이 팀번호는 이미 등록되어 있습니다.');
        }
    }
    function IsTeamNumberExist() {
        var result = false;
        
        $.ajax({
            url: '@Url.Action("IsAlreadyCoreValueRubricRegistered", "Admin")' + '?teamNumber=' + 1,
            type: 'POST',
            dataType: 'json',
            data: null,
            contentType: 'application/json; charset=utf-8',
            async: false,
            cache: false,
            success: function (data) {
                result = data.result;
            }
        });
        return result;
    }
</script>