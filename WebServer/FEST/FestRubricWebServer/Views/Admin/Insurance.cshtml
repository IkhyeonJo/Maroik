@model IEnumerable<FESTRubricWebServer.Models.Admin.InsuranceOutputModel>

@{
    ViewData["Title"] = "Insurance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>@(ViewBag.Category) 보험 처리 페이지</h2>
총 개수 : @Model.Count()

<table class="table">
    <thead>
        <tr>
            <th>
                @*@Html.DisplayNameFor(model => model.TeamNo)*@
                팀번호
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.TeamName)*@
                팀명
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.MemberName)*@
                팀원명
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.ResidentNumber)*@
                주민번호
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamNo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MemberName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ResidentNumber)
                </td>

            </tr>
        }
    </tbody>
</table>
<button type="button" onclick="GotoIndexPage()">인덱스(Index) 페이지로...</button>

<script>
    function GotoIndexPage() {
        window.location.href = "@Url.Action("Index", "Admin", new { Category = ViewBag.Category})";
    }
</script>