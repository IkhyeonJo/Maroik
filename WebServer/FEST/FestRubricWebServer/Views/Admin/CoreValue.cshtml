@using Microsoft.AspNetCore.Http
@model IEnumerable<FESTRubricWebServer.Models.Admin.AdminRubric>

@{
    ViewData["Title"] = $"핵심가치 심사 {Context.Session.GetString("FESTAdminSession").Split("~")[1]}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="CoreValueCreate">등록</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th style="text-align:center;">
                팀 번호
            </th>
            <th style="text-align:center;">
                심사위원
            </th>
            <th style="text-align:center;">
                발견
            </th>
            <th style="text-align:center;">
                팀 정체성
            </th>
            <th style="text-align:center;">
                영향
            </th>
            <th style="text-align:center;">
                효과
            </th>
            <th style="text-align:center;">
                효율성
            </th>
            <th style="text-align:center;">
                학생이 하였음
            </th>
            <th style="text-align:center;">
                포용
            </th>
            <th style="text-align:center;">
                존중
            </th>
            <th style="text-align:center;">
                협력
            </th>
            <th style="text-align:center;">
                총점
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.TeamNumber)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.Evaluator)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryOne0)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryOne1)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryOne2)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryTwo0)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryTwo1)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryTwo2)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryThree0)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryThree1)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryThree2)
                </td>
                <td style="text-align:center;">
                    @Html.DisplayFor(modelItem => item.CategoryScore)
                </td>
                <td style="text-align:center;">
                    @Html.ActionLink("편집", "CoreValueEdit", new {  id=item.TeamNumber  }) |
                    @Html.ActionLink("삭제", "CoreValueDelete", new { id=item.TeamNumber }, new { onclick = "return ConfirmBox();" })
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    function ConfirmBox() {
        var r = confirm("정말 삭제하시겠습니까?");
        if (r == true) {
            return true;
        } else {
            return false;
        }
    }
</script>