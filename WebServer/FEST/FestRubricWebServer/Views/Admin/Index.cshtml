@model List<FESTRubricWebServer.Models.Admin.TeamParticipationOutputModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script>
    var Ischecked = true;
    function checkAll() {
        if (Ischecked) {
            $("input[type=checkbox]").prop("checked", true);
            Ischecked = false;
        } else {
            $("input[type=checkbox]").prop("checked", false);
            Ischecked = true;
        }
    }
    function GotoMenuSelectPage() {
        window.location.href = "@Url.Action("MenuSelect", "Admin")";
    }
    function GotoInsurancePage() {
        window.location.href = "@Url.Action("Insurance", "Admin")" + "?Category=" + "@ViewBag.Category";
    }
    function GotoProgramBookPage() {
        window.location.href = "@Url.Action("ProgramBook", "Admin")" + "?Category=" + "@ViewBag.Category";
    }
    function GotoCurrentAllRegisteredMember() {
        window.location.href = "@Url.Action("CurrentAllRegisteredMember", "Admin")" + "?Category=" + "@ViewBag.Category";
    }
</script>
<h1 class="text-center">KRC Infonet</h1>
<h2>@ViewBag.Category 정보(Team Information)</h2>
<p>총 개수 : @Model.Count</p>



@using (Html.BeginForm("KRCSave", "Admin", FormMethod.Post))
{
    <table>
        <thead>
            <tr>
                <th>
                    번호&nbsp;&nbsp;
                </th>
                <th>
                    카테고리 &nbsp;
                </th>

                <th>
                    년도
                </th>

                <th>
                    팀 번호&nbsp;&nbsp;
                </th>

                <th>
                    팀 이름
                </th>

                <th>
                    코치 이름
                </th>

                <th>
                    코치 폰 번호
                </th>

                <th>
                    코치 이메일
                </th>

                <th>
                    코치 소속 기관
                </th>

                <th>
                    본선 참여&nbsp;&nbsp;&nbsp;
                </th>

                <th>
                    <button type="button" onclick="checkAll()">✓</button>
                </th>
            </tr>
        </thead>
        @for (int i = 0; i < Model.Count(); i++)
        {
            <tr>
                <td>
                    @(i + 1)&nbsp;
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].Category)
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].Year)&nbsp;&nbsp;&nbsp;
                </td>
                <td>
                    @*@Html.DisplayFor(model => model[i].TeamNo)*@
                    <a asp-controller="Admin" asp-action="RegisteredMember" asp-route-TeamNo="@Model[i].TeamNo" asp-route-Category="@ViewBag.Category">@Html.DisplayFor(model => model[i].TeamNo)</a>
                    @Html.HiddenFor(model => model[i].TeamNo)
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].TeamName)
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].CoachName)
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].CoachPhone)&nbsp;&nbsp;
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].CoachEmail)
                </td>
                <td>
                    @Html.DisplayFor(model => model[i].TeamOrganization)&nbsp;&nbsp;&nbsp;&nbsp;
                </td>

                <td>
                    @Html.DisplayFor(model => model[i].KRC)
                </td>
                <td>
                    @if (Model[i].KRC == "O")
                    {
                        <input type="checkbox" id="myCheck" asp-for="@Model[i].Checkbox" checked />
                    }
                    else if (Model[i].KRC == "X")
                    {
                        <input type="checkbox" id="myCheck" asp-for="@Model[i].Checkbox" />
                    }

                    <input type="hidden" asp-for="@Model[i].KRC" />
                </td>
            </tr>
        }
    </table>
    <br />
    <input type="submit" value="저장" />
    <button type="button" onclick="GotoMenuSelectPage()">메뉴 선택 페이지로...</button>
    <button type="button" onclick="GotoInsurancePage()">@ViewBag.Category 보험 처리 페이지로...</button>
    <button type="button" onclick="GotoProgramBookPage()">@ViewBag.Category 프로그램 북 페이지로...</button>
    <button type="button" onclick="GotoCurrentAllRegisteredMember()">@ViewBag.Category 선수 등록 현황 페이지로...</button>
}