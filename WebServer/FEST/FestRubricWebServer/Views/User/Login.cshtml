@model  FESTRubricWebServer.Models.User.LoginInputModel

@{
    ViewData["Title"] = "Login";
}
<h1 class="text-center">KRC Infonet</h1>
<h2 class="text-center">로그인(Login)</h2>

<form name="loginForm" class="form-horizontal" method="post" onsubmit="return ValidateLoginForm()" asp-controller="User" asp-action="Login">

    <div class="form-group">
        <label>이메일 주소(Email Address)</label>
        <input name="CoachEmail" type="text" class="form-control" asp-for="CoachEmail" placeholder="이메일 주소 (Input Email Address)" />
        <span class="text-danger" asp-validation-for="CoachEmail"></span>
    </div>

    <div class="form-group">
        <label>팀번호(Team Number)</label>
        <input id="TeamNo" type="text" class="form-control" asp-for="TeamNo" placeholder="팀번호 (Team Number)" maxlength="4"/>
        <span class="text-danger" asp-validation-for="TeamNo"></span>
    </div>

    <div class="form-group">
        <label>비밀번호 (Password)</label>
        <input name="CoachPassword" type="password" class="form-control" asp-for="CoachPassword" placeholder="비밀번호 입력 (Input Password)" maxlength="10"/>
        <span class="text-danger" asp-validation-for="CoachPassword"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">로그인(Login)</button>
        <button type="button" class="btn btn-danger" onclick="GotoRegister()">회원가입 페이지로... (Go to Register Page)</button>
        <button type="button" class="btn btn-danger" onclick="GotoResetPassword()">비밀번호 초기화 (Reset Password)</button>

    </div>

    <div class="text-danger" asp-validation-summary="ModelOnly"></div>

</form>

<script>
    function ValidateLoginForm() {
        var emailRegex = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        var strongPasswordRegex = new RegExp("^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@@#\$%\^&\*])(?=.{4,})");
        var teamNo = document.getElementById("TeamNo").value;

        if ((!emailRegex.test(String(document.forms["loginForm"]["CoachEmail"].value).toLowerCase())) || (isNaN(teamNo) || teamNo < 1000 || teamNo > 9999) || (!strongPasswordRegex.test(String(document.forms["loginForm"]["CoachPassword"].value)))) {
            alert("이메일 주소 또는 팀 번호 또는 비밀번호 형식이 잘못됐습니다. \n(Invalid Email Address or Team Number or Password Form)");
            return false;
        }

        else {
            return true;
        }
    }
    function GotoRegister() {
        window.location.href = "@Url.Action("Register", "User")";
    }
    function GotoResetPassword() {
        window.location.href = "@Url.Action("ResetPassword", "User")";
    }
</script>