@model FESTRubricWebServer.Models.User.ResetPasswordInputModel

@{
    ViewData["Title"] = "ResetPassword";
}
<h1 class="text-center">KRC Infonet</h1>
<h2 class="text-center">비밀번호 초기화(Reset Password)</h2>

<form name="resetPasswordForm" class="form-horizontal" method="post" onsubmit="return ValidateResetForm()" asp-controller="User" asp-action="ResetPassword">

    <div class="form-group">
        <label>이메일 주소(Email Address)</label>
        <input name="CoachEmail" type="text" class="form-control" asp-for="CoachEmail" placeholder="이메일 주소 (Input Email Address)" />
        <span class="text-danger" asp-validation-for="CoachEmail"></span>
    </div>

    <div class="form-group">
        <label>팀번호(Team Number)</label>
        <input id="TeamNo" type="text" class="form-control" asp-for="TeamNo" placeholder="팀번호 (Team Number)" maxlength="4" />
        <span class="text-danger" asp-validation-for="TeamNo"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">비밀번호 초기화(Reset Password)</button>
        <button type="button" class="btn btn-danger" onclick="GotoLogin()">로그인 페이지로... (Go to Login Page)</button>

    </div>

    <div class="text-danger" asp-validation-summary="ModelOnly"></div>

</form>

<script>
    function ValidateResetForm() {
        var emailRegex = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        var teamNo = document.getElementById("TeamNo").value;

        if (!emailRegex.test(String(document.forms["resetPasswordForm"]["CoachEmail"].value).toLowerCase())) {
            alert("유효하지 이메일 주소 형식입니다. \n(Invalid Email Address Form.)");
            return false;
        }

        else if (isNaN(teamNo) || teamNo < 1000 || teamNo > 9999) {
            alert("유효하지 않은 팀번호 형식입니다. 4자리 숫자만 입력해주세요. \n(The TeamNumber must be a number between 1000 and 9999)");
            return false;
        }

        else {
            return true;
        }
    }
    function GotoLogin() {
        window.location.href = "@Url.Action("Login", "User")";
    }
</script>