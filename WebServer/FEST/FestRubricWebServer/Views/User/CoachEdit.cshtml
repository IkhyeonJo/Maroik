@model FESTRubricWebServer.Models.User.CoachInputModel

@{
    ViewData["Title"] = "CoachEdit";
}
<h2>코치 정보 편집 (Edit Coach Info)</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CoachEdit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CoachName" class="control-label">코치 이름 (Coach Name)</label>
                <input asp-for="CoachName" class="form-control" />
                <span asp-validation-for="CoachName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoachPhone" class="control-label">코치 핸드폰 (Coach Phone)</label>
                <input asp-for="CoachPhone" class="form-control" />
                <span asp-validation-for="CoachPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoachEmail" class="control-label">코치 이메일 (Coach Email)</label>
                <input asp-for="CoachEmail" class="form-control" />
                <span asp-validation-for="CoachEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamOrganization" class="control-label">코치 조직 (Coach Organization)</label>
                <input asp-for="TeamOrganization" class="form-control" />
                <span asp-validation-for="TeamOrganization" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save (저장)" class="btn btn-primary" />
                <button type="button" class="btn btn-danger" onclick="GotoNotice()">Cancel (나가기)</button>
            </div>
        </form>
    </div>
</div>

<script>
    function GotoNotice() {
        window.location.href = "@Url.Action("Notice", "User")";
    }
</script>
