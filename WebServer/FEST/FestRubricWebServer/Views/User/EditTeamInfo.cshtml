@model FESTRubricWebServer.Models.User.TeamInputModel

@{
    ViewData["Title"] = "EditTeamInfo";
}
<h2>팀 정보 편집 (Edit Team Info)</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditTeamInfo" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Category" class="control-label">카테고리 (Category)</label>
                <input asp-for="Category" class="form-control" readonly/>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamNo" class="control-label">팀 번호 (Team Number)</label>
                <input asp-for="TeamNo" class="form-control" readonly/>
                <span asp-validation-for="TeamNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TeamName" class="control-label">팀 이름 (TeamName)</label>
                <input asp-for="TeamName" class="form-control" />
                <span asp-validation-for="TeamName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save (저장)" class="btn btn-primary" />
                <button type="button" class="btn btn-danger" onclick="GotoNotice()">Cancel (나가기)</button>
            </div>
        </form>
    </div>
</div>
<script>
    function GotoNotice() {
        window.location.href = "@Url.Action("Notice", "User")";
    }
</script>
