@model IEnumerable<FESTRubricWebServer.Models.User.TeamOutputModel>

@{
    ViewData["Title"] = "TeamInfo";
}
<h2>팀 정보 (Team Info)</h2><br />
<h4><font color="red">기한 : 2018년 12월 28일까지 (Deadline : December 28, 2018)</font></h4><br />

<table class="table">
    <thead>
        <tr>
            <th>
                @*@Html.DisplayNameFor(model => model.Category)*@
                카테고리 (Category)
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.TeamNo)*@
                팀 번호 (Team Number)
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.TeamName)*@
                팀 이름 (Team Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Category)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamNo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TeamName)
                </td>
                @if (!(DateTime.Compare(DateTime.Now, new DateTime(2018, 12, 29)) >= 0))
                {
                <td>
                    @Html.ActionLink("Edit", "EditTeamInfo")
                </td>
                }
                else
                {
                <td>
                    <font color="red">기한 : 2018년 12월 28일까지 (Deadline : December 28, 2018)</font>
                </td>
                }
            </tr>
        }

    </tbody>

</table>

<button type="button" class="btn btn-danger" onclick="GotoNotice()">Cancel (나가기)</button>

<script>
    function GotoNotice() {
        window.location.href = "@Url.Action("Notice", "User")";
    }
</script>