@model FESTRubricWebServer.Models.User.RegisterInputModel

@{
    ViewData["Title"] = "Register";
}
<h1 class="text-center">KRC Infonet</h1>
<h2 class="text-center">회원가입(Registration)</h2>

<form name="registerForm" class="form-horizontal" method="post" onsubmit="return ValidateRegisterForm()" asp-controller="User" asp-action="Register">

    <div class="form-group">
        <label>이메일 주소(Email Address)</label>
        <input name="CoachEmail" type="text" class="form-control" asp-for="CoachEmail" placeholder="이메일 주소 (Input Email Address)" />
        <span class="text-danger" asp-validation-for="CoachEmail"></span>
    </div>

    <div class="form-group">
        <label>팀번호(Team Number)</label>
        <input id="TeamNo" type="text" class="form-control" asp-for="TeamNo" placeholder="팀번호 (Team Number)" maxlength="4" />
        <span class="text-danger" asp-validation-for="TeamNo"></span>
    </div>

    <div class="form-group">
        <label>비밀번호 (Password)</label>
        <input name="CoachPassword" type="password" class="form-control" asp-for="CoachPassword" placeholder="비밀번호 입력 (Input Password)" maxlength="10" />
        <span class="text-danger" asp-validation-for="CoachPassword"></span>
    </div>

    <div class="form-group">
        <label>확인 비밀번호 (Confirm Password)</label>
        <input name="ConfirmCoachPassword" type="password" class="form-control" asp-for="ConfirmCoachPassword" placeholder="확인 비밀번호 입력 (Input Confirm Password)" maxlength="10" />
        <span class="text-danger" asp-validation-for="ConfirmCoachPassword"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">회원가입(Registration)</button>
        <button type="button" class="btn btn-danger" onclick="GotoLogin()">로그인 페이지로... (Go to Login Page)</button>
    </div>

    <div class="text-danger" asp-validation-summary="ModelOnly"></div>

</form>

<script>
    function ValidateRegisterForm() {
        var emailRegex = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        var strongPasswordRegex = new RegExp("^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@@#\$%\^&\*])(?=.{4,})");
        var teamNo = document.getElementById("TeamNo").value;

        if ((!emailRegex.test(String(document.forms["registerForm"]["CoachEmail"].value).toLowerCase()))) {
            alert("유효하지 않은 이메일 형식입니다. \n(Invalid Email Form)");
            return false;
        }

        else if (isNaN(teamNo) || teamNo < 1000 || teamNo > 9999) {
            alert("유효하지 않은 팀번호 형식입니다. 4자리 숫자만 입력해주세요. \n(The TeamNumber must be a number between 1000 and 9999)");
            return false;
        }

        else if (!strongPasswordRegex.test(String(document.forms["registerForm"]["CoachPassword"].value))) {
            alert("비밀번호는 숫자, 대소문자 그리고 특수문자를 적어도 총 4개 이상 포함해야 합니다. \n(Password must be contain at least contain 4 letters consist of Number, lower&Upper Case And Special letter)");
            return false;
        }

        else if (document.forms["registerForm"]["CoachPassword"].value != document.forms["registerForm"]["ConfirmCoachPassword"].value) {
            alert("비밀번호와 확인 비밀번호가 다릅니다. \n(Does not match Password And Confirm Password)");
            return false;
        }
        else {
            return true;
        }
    }
    function GotoLogin() {
        window.location.href = "@Url.Action("Login", "User")";
    }

</script>