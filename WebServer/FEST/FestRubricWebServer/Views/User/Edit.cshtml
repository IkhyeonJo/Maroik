@model FESTRubricWebServer.Models.User.MemberInputModel

@{
    ViewData["Title"] = "Edit";
}
<h2>팀원 정보 편집 (Edit Team Member)</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form name="EditForm" asp-action="Edit" method="post" onsubmit="return ValidateEditForm()" onload="fool()">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MemberID" class="form-control" readonly="readonly" />
            <div class="form-group">
                <label asp-for="MemberName" class="control-label">@Html.DisplayNameFor(m => m.MemberName) (팀원 이름)<font color="red"> *</font></label>
                <input asp-for="MemberName" class="form-control" placeholder="ex) 홍길동 (peter)" />
                <span asp-validation-for="MemberName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ResidentNumber" class="control-label">@Html.DisplayNameFor(m => m.ResidentNumber) (주민등록번호)<font color="red"> *</font></label>

                <label asp-for="IsForeigner" class="alert-warning">[Foreigner (주민등록번호가 없는 경우 체크합니다.)]</label>
                @if (Model.IsForeigner == true)
                {
                    <input asp-for="IsForeigner" id="Foreigner" type="checkbox" onclick="EraseContentAndReadOnly()" checked />
                    <input id="ResidentNumber" asp-for="ResidentNumber" class="form-control" placeholder="ex) 990112-1111111" readonly />
                }
                else
                {
                    <input asp-for="IsForeigner" id="Foreigner" type="checkbox" onclick="EraseContentAndReadOnly()" />
                    <input id="ResidentNumber" asp-for="ResidentNumber" class="form-control" placeholder="ex) 990112-1111111" />
                }
                @*<span asp-validation-for="ResidentNumber" class="text-danger"></span>*@
            </div>
            <div class="form-group">
                <label asp-for="Level" class="control-label">@Html.DisplayNameFor(m => m.Level) (학제)<font color="red"> *</font></label>
                <br />
                <select id="LevelID" asp-for="Level">
                    <option value="PreSchool">미취학(PreSchool)</option>
                    <option value="Elementary">초등(Elementary)</option>
                    <option value="Middle">중등(Middle)</option>
                    <option value="High">고등(High)</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Grade" class="control-label">@Html.DisplayNameFor(m => m.Grade)/Age (학년/나이)<font color="red"> *</font></label>
                <br />
                <select asp-for="Grade">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="School" class="control-label">@Html.DisplayNameFor(m => m.School) (학교명)<font color="red"> *</font></label>
                <input asp-for="School" class="form-control" placeholder="ex) 00초등학교 (00 elementary School)" />
                <span asp-validation-for="School" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemberPhone" class="control-label">@Html.DisplayNameFor(m => m.MemberPhone) (팀원 핸드폰 번호)</label>
                <input asp-for="MemberPhone" class="form-control" placeholder="010-0000-0000" />
                <span asp-validation-for="MemberPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemberEmail" class="control-label">@Html.DisplayNameFor(m => m.MemberEmail) (팀원 이메일)</label>
                <input asp-for="MemberEmail" class="form-control" placeholder="qwerty@qwerty.com" />
                <span asp-validation-for="MemberEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GuardianName1" class="control-label">GuardianName (보호자 성명)<font color="red"> *</font></label>
                <input asp-for="GuardianName1" class="form-control" placeholder="홍길동 (Peter)" />
                <span asp-validation-for="GuardianName1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GuardianPhone1" class="control-label">Guardian Phone (보호자 전화번호)<font color="red"> *</font></label>
                <input asp-for="GuardianPhone1" class="form-control" placeholder="010-0000-0000" />
                <span asp-validation-for="GuardianPhone1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RelationShip1" class="control-label">RelationShip (팀원과의 관계)<font color="red"> *</font></label>
                <input asp-for="RelationShip1" class="form-control" placeholder="부/모(Mother/Father)" />
                <span asp-validation-for="RelationShip1" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save (저장)" class="btn btn-primary" />
                <button type="button" class="btn btn-danger" onclick="GotoIndex()">Cancel (나가기)</button>
            </div>


        </form>
    </div>
</div>


<script>
    window.onload = function () {
        var levelName = '@Model.Level';
        if (levelName == "PreSchool") {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', false);
            $('option[value=5]').prop('disabled', false);
            $('option[value=6]').prop('disabled', false);
            $('option[value=7]').prop('disabled', false);
        }
        else if (levelName == "Elementary") {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', false);
            $('option[value=5]').prop('disabled', false);
            $('option[value=6]').prop('disabled', false);
            $('option[value=7]').prop('disabled', true);
        }
        else {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', true);
            $('option[value=5]').prop('disabled', true);
            $('option[value=6]').prop('disabled', true);
            $('option[value=7]').prop('disabled', true);
        }
    }

    var levelMenu = document.getElementById('LevelID');
    var gradeInput = document.getElementById("gradeID");

    levelMenu.onchange = function () {
        
        var levelOption = this.options[this.selectedIndex];

        if (levelOption.value == "PreSchool") {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', false);
            $('option[value=5]').prop('disabled', false);
            $('option[value=6]').prop('disabled', false);
            $('option[value=7]').prop('disabled', false);
            $("option:selected").removeAttr("selected");
            $('option[value=1]').attr('selected', 'selected');
        }
        else if (levelOption.value == "Elementary") {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', false);
            $('option[value=5]').prop('disabled', false);
            $('option[value=6]').prop('disabled', false);
            $('option[value=7]').prop('disabled', true);
            $("option:selected").removeAttr("selected");
            $('option[value=1]').attr('selected', 'selected');
        }
        else {
            $('option[value=1]').prop('disabled', false);
            $('option[value=2]').prop('disabled', false);
            $('option[value=3]').prop('disabled', false);
            $('option[value=4]').prop('disabled', true);
            $('option[value=5]').prop('disabled', true);
            $('option[value=6]').prop('disabled', true);
            $('option[value=7]').prop('disabled', true);
            $("option:selected").removeAttr("selected");
            $('option[value=1]').attr('selected', 'selected');
        }
    }

    function ValidateEditForm() {
        if (document.getElementById("Foreigner").checked == true)
            return true;

        var buf = [], sum = 0, i, j = 2;
        var x = document.getElementById("ResidentNumber").value;

        for (i = 0; i < x.length - 1; i++) {
            if (x[i] != '-') {
                sum += Number(x[i]) * j++;
            }
            if (j == 10) j = 2;
        }
        //window.alert((11-sum%11)%10);
        if ((11 - sum % 11) % 10 != x[13]) {
            window.alert("주민등록번호가 틀리니 확인하시기 바랍니다. (Invalid ResidentNumber.)");
            return false;
        }

        else {
            return true;
        }
    }
    function GotoIndex() {
        window.location.href = "@Url.Action("Index", "User")";
    }

    function EraseContentAndReadOnly() {
        var residentNumber = document.getElementById('ResidentNumber');
        var IsForeignerCheckboxChecker = document.getElementById("Foreigner").checked;
        if (IsForeignerCheckboxChecker == true) {
            residentNumber.value = "";
            residentNumber.setAttribute("readonly", true);
        }
        else {
            residentNumber.value = "";
            residentNumber.removeAttribute("readonly");
        }
    }
</script>