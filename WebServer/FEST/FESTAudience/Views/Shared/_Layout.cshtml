                <ul class="nav navbar-nav navbar-left">
                    @if (Context.Session.GetString("FestSession") == null)
                    {

                    }
                    else
                    {
                        if (Convert.ToInt32(Context.Session.GetString("FestSession")) / 1000 == 5)
                        {
                            <li><a asp-area="" asp-controller="User" asp-action="Notice">공지사항</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="Index">팀원 정보 등록</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="FTCTeamDocuments">FTC 팀 서류 제출</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="KRCWrittenOath">KRC 팀 서약서</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="KRCAdmissionTicket">KRC 팀 입장권</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="CoachInfo">코치 정보</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="TeamInfo">팀 정보</a></li>
                        }
                        else
                        {
                            <li><a asp-area="" asp-controller="User" asp-action="Notice">공지사항</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="Index">팀원 정보 등록</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="KRCWrittenOath">KRC 팀 서약서(KRC Team Written Oath)</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="KRCAdmissionTicket">KRC 팀 입장권(KRC Team AdmissionTicket)</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="CoachInfo">코치 정보</a></li>
                            <li><a asp-area="" asp-controller="User" asp-action="TeamInfo">팀 정보</a></li>
