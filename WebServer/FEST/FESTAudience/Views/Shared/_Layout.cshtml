                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @if (Context.Session.GetString("FestSession") == null)
                    {
                        <li><a asp-area="" asp-controller="User" asp-action="Register">회원가입 (Register)</a></li>
                        <li><a asp-area="" asp-controller="User" asp-action="Login">로그인 (Login)</a></li>
                    }
                    else
                    {
                        <li><a asp-area="" asp-controller="User" asp-action="Logout">로그아웃 (Logout)</a></li>
                    }

                </ul>
            </div>*@
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2018 - FEST 창의공학교육협회</p>
        </footer>
