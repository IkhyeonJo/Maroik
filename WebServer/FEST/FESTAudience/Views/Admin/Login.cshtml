@model FESTRubricWebServer.Models.Admin.AdminLoginInputModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h1 class="text-center">KRC Infonet</h1>
<h2 class="text-center">로그인(Login)</h2>

<form class="form-horizontal" method="post" asp-controller="Admin" asp-action="Login">

    <div class="form-group">
        <label>ID</label>
        <input type="text" class="form-control" asp-for="ID" placeholder="ID" />
        <span class="text-danger" asp-validation-for="ID"></span>
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" asp-for="Password" placeholder="password" maxlength="10" />
        <span class="text-danger" asp-validation-for="Password"></span>
    </div>


    <div class="form-group">
        <button type="submit" class="btn btn-primary">Login</button>
    </div>

    <div class="text-danger" asp-validation-summary="ModelOnly"></div>

</form>