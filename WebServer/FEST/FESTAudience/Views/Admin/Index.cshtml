@model List<FESTRubricWebServer.Models.Admin.QuestionnaireInputModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("Index", "Admin", FormMethod.Post))
{
<table class="table">
    <thead>
        <tr>
            <th>
                번호
            </th>
            <th>
                성명
            </th>
            <th>
                상태
            </th>
            <th>
                배지 지급 버튼
            </th>
            <th>
                휴대폰 번호
            </th>
            <th>
                이메일 주소
            </th>
            <th>
                소속 기관
            </th>
            <th>
                직책
            </th>
        </tr>
    </thead>
    <tbody>
@for(int i=0; i < Model.Count(); i++)
{
        <tr>
            <td>
                @(i+1)
                <input type="hidden" asp-for="@Model[i].PK"/>
            </td>
            <td>
                @Html.DisplayFor(model => model[i].Name)
                <input type="hidden" asp-for="@Model[i].Name" />
            </td>
            <td>
                @Html.DisplayFor(model => model[i].State)
                <input type="hidden" asp-for="@Model[i].State" />
            </td>
            <td>
                @if (Model[i].State == "입장")
                {
                    <input type="checkbox" id="myCheck" asp-for="@Model[i].Checked" checked />
                }
                else if (Model[i].State == "등록")
                {
                    <input type="checkbox" id="myCheck" asp-for="@Model[i].Checked" />
                }
            </td>
            <td>
                @Html.DisplayFor(model => model[i].PhoneNumber)
                <input type="hidden" asp-for="@Model[i].PhoneNumber" />
            </td>
            <td>
                @Html.DisplayFor(model => model[i].Email)
                <input type="hidden" asp-for="@Model[i].Email" />
            </td>
            <td>
                @Html.DisplayFor(model => model[i].Affiliation)
                <input type="hidden" asp-for="@Model[i].Affiliation" />
            </td>
            <td>
                @Html.DisplayFor(model => model[i].Position)
                <input type="hidden" asp-for="@Model[i].Position" />
            </td>
        </tr>
}
    </tbody>
</table>
    <input type="submit" value="저장"/>
}