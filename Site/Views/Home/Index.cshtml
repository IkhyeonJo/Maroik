@model List<AspNetCoreMVCSample.src.Site.Models.Home.Product>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Aplicação ASP.NET CORE MVC 3.1 com Docker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AspNetCoreMVCSample.src.Site.Models.Home.Product item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nome</td>
                    <td>@item.Categoria</td>
                    <td>@item.Valor</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>